CombatBox < UICheckBox
  size: 20 20
  image-clip: 0 0 20 20
  margin: 2 4

  $checked:
    image-clip: 0 20 20 20

ChaseModeBox < CombatBox
  image-source: /images/game/combatmodes/chasemode
MiniPanel < Panel
  text-offset: 0 3
  text-align: top
  image-source: /images/ui/outfits/minipanel
  image-border: 3
  image-border-top: 22
  padding-left: 6
  padding-bottom: 6
  padding-top: 25
  padding-right: 6
  color: #929292

RotateButton < UIButton
  anchors.bottom: parent.bottom
  size: 20 20
  margin-bottom: 3
  image-source: /images/ui/outfits/rotate_button
  image-color: #dfdfdf

  $hover:
    image-color: #ffffff

PresetButton < Panel
  height: 100
  image-source: /images/ui/button
  image-color: #dfdfdf
  image-clip: 0 0 22 23
  image-border: 3
  border: 1 alpha
  focusable: true
  phantom: false

  $hover:
    image-color: #ffffff

  $focus:
    border: 1 white

  
  UICreature
    id: creature
    anchors.centerIn: parent
    size: 64 64
    phantom: true
  
  Label
    id: title
    anchors.top: creature.bottom
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 5
    margin-right: 5
    margin-bottom: 5
    text-align: bottom
    text-wrap: true

  Panel
    id: rename
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 23
    margin-left: 5
    margin-right: 5
    margin-bottom: 5
    visible: false

    TextEdit
      id: input
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      width: 150
      placeholder: Preset Name
      max-length: 24
    
    Button
      id: save
      anchors.top: parent.top
      anchors.right: parent.right
      anchors.left: prev.right
      margin-left: 5
      text: Save

SelectionButton < Panel
  image-source:  /images/ui/button-grey-qt
  image-clip: 0 0 98 40
  image-border: 3
  border: 1 alpha
  focusable: true
  phantom: false
  $focus:
    border: 1 white

  
  UICreature
    id: outfit
    anchors.centerIn: parent
    size: 64 64
    margin-bottom: 10
    phantom: true
  
  Panel
    id: bar
    anchors.centerIn: parent
    visible: false
  
  Label
    id: name
    anchors.top: outfit.bottom
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 5
    margin-right: 5
    margin-bottom: 5
    text-align: bottom
    text-wrap: true

OutfitSelectionButton < Panel
  image-source:  /images/ui/button-grey-qt
  image-clip: 0 0 98 40
  image-border: 3
  border: 1 alpha
  focusable: true
  phantom: false
  $focus:
    border: 1 white


  UICreature
    id: outfit
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.top
    size: 64 64
    margin-top: 5
    phantom: true

  Panel
    id: bar
    anchors.centerIn: parent
    visible: false

  UIWidget
    id: help
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 5
    margin-right: 5
    size: 12 12
    image-source: /images/skin/show-gui-help-grey
    tooltip: If you have saved a little fortune, you can go to King Tibianus, Queen Eloise or Emperor Kruzak to buy this precious suit of armor directly out of their royal treasury.
    visible: false

  Label
    id: name
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 26
    margin-left: 5
    margin-right: 6
    margin-bottom: 5
    font: verdana-bold-11px-native
    color: #c0c0c0
    text-align: bottom
    text-wrap: true
    @onTextChange: modules.game_outfit.fitSelectionName(self)
    @onGeometryChange: modules.game_outfit.fitSelectionName(self)

OutfitButton < UIButton
  size: 43 20
  font: verdana-bold-8px-native
  color: #c0c0c0
  image-source: /images/ui/button-grey-up
  image-border: 1
  text-align: center

  $pressed:
    image-source: /images/ui/button-grey-down
    text-offset: 1 1

  $disabled:
    color: #808080

OutfitPanel < Panel
  color: #00000000
  image-source: /images/ui/2pixel-up-frame-borderimage
  image-border: 2
  padding: 22 7 7 7
  @onTextChange: if self.header then self.header:setText(self:getText()) end

  Label
    id: header
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    margin: -22 -7 0 -7
    height: 17
    font: verdana-bold-11px-native
    color: #909090
    text-align: center
    image-source: /images/ui/2pixel-up-header-smoother
    image-border: 2
    image-border-bottom: 1
    phantom: true

OutfitColorTab < UICheckBox
  height: 18
  font: verdana-bold-8px-native
  text-align: center
  color: #c0c0c0
  image-source: /images/ui/outfits/console-tab-passive
  image-border: 2

  $checked:
    image-source: /images/ui/outfits/console-tab-active

OutfitColorBox < UICheckBox
  size: 13 13
  image-source: /images/ui/2pixel-up-frame-borderimage
  image-border: 2
  border: 1 alpha

  $checked:
    image-source: /images/ui/outfits/2pixel-up-frame-borderimage-upside-down
    border: 1 white

  UIWidget
    id: fill
    anchors.fill: parent
    margin: 2
    phantom: true

OutfitWindow < MainWindow
  size: 756 575
  text: Customise Character
  color: #909090
  font: verdana-bold-11px-native
  image-source: /images/ui/classic-dialog
  image-border: 4
  image-border-top: 17
  text-offset: 0 2
  padding: 29 16 16 16
  @onEnter: modules.game_outfit.accept()
  @onEscape: modules.game_outfit.destroy()

  OutfitPanel
    id: preview
    anchors.top: parent.top
    anchors.left: parent.left
    size: 479 220
    text: Preview

    Panel
      id: options
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      width: 128
      layout:
        type: verticalBox
        spacing: 5

      FlatPanel
        id: showFloor
        height: 22
        padding: 5

        CheckBox
          font: verdana-bold-11px-native
          id: check
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: parent.left
          anchors.right: parent.right
          text: Show Floor

      FlatPanel
        id: showOutfit
        height: 22
        padding: 5

        CheckBox
          font: verdana-bold-11px-native
          id: check
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: parent.left
          anchors.right: parent.right
          text: Show Outfit
          checked: true

      FlatPanel
        id: showMount
        height: 22
        padding: 5

        CheckBox
          font: verdana-bold-11px-native
          id: check
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: parent.left
          anchors.right: parent.right
          text: Show Mount

      FlatPanel
        id: showFamiliar
        height: 22
        padding: 5
        @onSetup: |
          if not g_game.getFeature(GamePlayerFamiliars) then
            self:hide()
            self:setHeight(0)
            self:setPadding(0)
          end

        CheckBox
          font: verdana-bold-11px-native
          id: check
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: parent.left
          anchors.right: parent.right
          text: Show Familiar
          @onSetup: |
            if not g_game.getFeature(GamePlayerFamiliars) then
              self:hide()
            end

      FlatPanel
        id: showWings
        height: 22
        padding: 5
        visible:false

        CheckBox
          font: verdana-bold-11px-native
          id: check
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: parent.left
          anchors.right: parent.right
          text: Show Wings

      FlatPanel
        id: showAura
        height: 22
        padding: 5
        visible:false
        CheckBox
          font: verdana-bold-11px-native
          id: check
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: parent.left
          anchors.right: parent.right
          text: Show Aura

      FlatPanel
        id: showShader
        height: 22
        padding: 5
        visible:false
        CheckBox
          font: verdana-bold-11px-native
          id: check
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: parent.left
          anchors.right: parent.right
          text: Show Shader

      FlatPanel
        id: showBars
        height: 22
        padding: 5
        visible:true
        CheckBox
          font: verdana-bold-11px-native
          id: check
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: parent.left
          anchors.right: parent.right
          text: Show Bars
          
      FlatPanel
        id: showTitle
        height: 22
        padding: 5
        visible:false
        CheckBox
          font: verdana-bold-11px-native
          id: check
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: parent.left
          anchors.right: parent.right
          text: Show title

      FlatPanel
        id: showEffects
        height: 22
        padding: 5
        visible:false
        CheckBox
          font: verdana-bold-11px-native
          id: check
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: parent.left
          anchors.right: parent.right
          text: Show Effects

    FlatPanel
      id: panel
      anchors.top: parent.top
      anchors.left: prev.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      padding: 1
      margin-left: 5
      clipping: true

      Panel
        id: floor
        anchors.centerIn: parent
        size: 448 448
        
        layout:
          type: grid
          cell-size: 64 64
          flow: true

      UICreature
        id: UIfamiliar
        anchors.centerIn: parent
        size: 64 64
        @onSetup: |
          if not g_game.getFeature(GamePlayerFamiliars) then
            self:hide()
          end

      UICreature
        id: creature
        anchors.centerIn: parent
        size: 64 64
        margin-top: 26
        margin-left: -16
      
      Panel
        id: bars
        anchors.horizontalCenter: prev.horizontalCenter
        anchors.top: prev.top
        margin-top: 47
        margin-right: 20
        size: 300 32

        Label
          id: name
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          font: verdana-11px-rounded
          color: #00BC00
          text-align: center
        
        Panel
          id: healthBar
          anchors.top: name.bottom
          anchors.horizontalCenter: name.horizontalCenter
          size: 27 4
          margin-top: 1
          background: #00BC00
          border: 1 black

          Panel
            id: image
            anchors.centerIn: parent

        Panel
          id: manaBar
          anchors.top: prev.bottom
          anchors.horizontalCenter: name.horizontalCenter
          size: 27 4
          background: #0000FF
          border: 1 black

          Panel
            id: image
            anchors.centerIn: parent
      
      ChaseModeBox
        id: movement
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 3
        margin-left: 3
        image-color: #dfdfdf
        tooltip: Enable/Disable movement animation

        $hover:
          image-color: #ffffff

      RotateButton
        anchors.left: parent.left
        margin-left: 3
        image-clip: 0 0 20 20
        @onClick: modules.game_outfit.rotate(1)

        $pressed:
          image-clip: 0 20 20 20
      
      RotateButton
        anchors.right: parent.right
        margin-right: 3
        image-clip: 20 0 20 20
        @onClick: modules.game_outfit.rotate(-1)

        $pressed:
          image-clip: 20 20 20 20
  
  OutfitPanel
    id: configure
    anchors.top: prev.bottom
    anchors.bottom: separator.top
    anchors.left: parent.left
    width: 142
    margin-top: 5
    margin-bottom: 5
    text: Configure

    FlatPanel
      id: addon1
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      height: 22
      padding: 5

      CheckBox
        font: verdana-bold-11px-native
        id: check
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: parent.left
        anchors.right: parent.right
        text: Addon 1

    FlatPanel
      id: addon2
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: addon1.bottom
      margin-top: 6
      height: 22
      padding: 5

      CheckBox
        font: verdana-bold-11px-native
        id: check
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: parent.left
        anchors.right: parent.right
        text: Addon 2

    FlatPanel
      id: mount
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: addon2.bottom
      margin-top: 6
      height: 22
      padding: 5

      CheckBox
        font: verdana-bold-11px-native
        id: check
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: parent.left
        anchors.right: parent.right
        text: Mount

  OutfitPanel
    id: appearance
    anchors.top: preview.bottom
    anchors.left: prev.right
    anchors.right: preview.right
    anchors.bottom: prev.bottom
    margin-top: 5
    margin-left: 5
    text: Change Appearance

    ScrollablePanel
      id: settings
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      image-source: /images/ui/panel_flat
      image-border: 1
      padding: 5
      padding-right: 15
      height: 86
      vertical-scrollbar: scrollbar
      layout:
        type: verticalBox
        spacing: 2
      
      Panel
        id: preset
        height: 20

        CheckBoxCircle
          id: check
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: parent.left
          size: 12 12
          font: verdana-bold-11px-native
          text: Preset:
          text-offset: 15 0
          width: 84
          color: #c0c0c0
          image-source: /images/ui/checkboxcircle
          image-clip: 0 0 12 12

          $hover !disabled:
            color: #C0C0C0
        
        FlatPanel
          id: name
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          anchors.left: prev.right
          anchors.right: parent.right
          text: -
      
      Panel
        id: outfit
        height: 20

        CheckBoxCircle
          id: check
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: parent.left
          text-offset: 15 0
          text: Outfit:
          size: 12 12
          font: verdana-bold-11px-native
          width: 84
          color: #c0c0c0
          image-source: /images/ui/checkboxcircle
          image-clip: 0 0 12 12

          $hover !disabled:
            color: #C0C0C0
        
        FlatPanel
          id: name
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          anchors.left: prev.right
          anchors.right: parent.right
      
      Panel
        id: mount
        height: 20

        CheckBoxCircle
          id: check
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: parent.left
          text-offset: 15 0
          size: 12 12
          font: verdana-bold-11px-native
          text: Mount:
          width: 84
          color: #c0c0c0
          image-source: /images/ui/checkboxcircle
          image-clip: 0 0 12 12

          $hover !disabled:
            color: #C0C0C0
        
        FlatPanel
          id: name
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          anchors.left: prev.right
          anchors.right: parent.right

      Panel
        id: familiar
        height: 20
        @onSetup: |
          if not g_game.getFeature(GamePlayerFamiliars) then
            self:hide()
            self:setHeight(0)
          end

        CheckBoxCircle
          id: check
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: parent.left
          text-offset: 15 0
          text: Familiar:
          size: 12 12
          font: verdana-bold-11px-native
          width: 84
          @onSetup: |
            if not g_game.getFeature(GamePlayerFamiliars) then
              self:hide()
            end
          color: #c0c0c0
          image-source: /images/ui/checkboxcircle
          image-clip: 0 0 12 12

          $hover !disabled:
            color: #C0C0C0

        FlatPanel
          id: name
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          anchors.left: prev.right
          anchors.right: parent.right
          @onSetup: |
            if not g_game.getFeature(GamePlayerFamiliars) then
              self:hide()
            end

      Panel
        id: wings
        height: 20
        visible:false
        CheckBoxCircle
          id: check
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: parent.left
          text-offset: 15 0
          size: 12 12
          font: verdana-bold-11px-native
          text: Wings:
          width: 84
          color: #c0c0c0
          image-source: /images/ui/checkboxcircle
          image-clip: 0 0 12 12

          $hover !disabled:
            color: #C0C0C0
        
        FlatPanel
          id: name
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          anchors.left: prev.right
          anchors.right: parent.right
      
      Panel
        id: aura
        height: 20
        visible:false
        CheckBoxCircle
          id: check
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: parent.left
          text-offset: 15 0
          size: 12 12
          font: verdana-bold-11px-native
          text: Aura:
          width: 84
          color: #c0c0c0
          image-source: /images/ui/checkboxcircle
          image-clip: 0 0 12 12

          $hover !disabled:
            color: #C0C0C0
        
        FlatPanel
          id: name
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          anchors.left: prev.right
          anchors.right: parent.right
      
      Panel
        id: shader
        height: 20
        visible:false
        CheckBoxCircle
          id: check
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: parent.left
          text-offset: 15 0
          size: 12 12
          font: verdana-bold-11px-native
          text: Shader:
          width: 84
          color: #c0c0c0
          image-source: /images/ui/checkboxcircle
          image-clip: 0 0 12 12

          $hover !disabled:
            color: #C0C0C0
        
        FlatPanel
          id: name
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          anchors.left: prev.right
          anchors.right: parent.right
      
      Panel
        id: healthBar
        height: 20
        visible:false
        CheckBoxCircle
          id: check
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: parent.left
          text-offset: 15 0
          size: 12 12
          font: verdana-bold-11px-native
          text: Health Bar:
          width: 84
          color: #c0c0c0
          image-source: /images/ui/checkboxcircle
          image-clip: 0 0 12 12

          $hover !disabled:
            color: #C0C0C0
        
        FlatPanel
          id: name
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          anchors.left: prev.right
          anchors.right: parent.right
      
      Panel
        id: effects
        height: 20
        visible:false
        CheckBoxCircle
          id: check
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: parent.left
          text-offset: 15 0
          size: 12 12
          font: verdana-bold-11px-native
          text: Effects:
          width: 84
          color: #c0c0c0
          image-source: /images/ui/checkboxcircle
          image-clip: 0 0 12 12

          $hover !disabled:
            color: #C0C0C0
        
        FlatPanel
          id: name
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          anchors.left: prev.right
          anchors.right: parent.right

      Panel
        id: title
        height: 20
        visible:false
        CheckBoxCircle
          id: check
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: parent.left
          text-offset: 15 0
          size: 12 12
          font: verdana-bold-11px-native
          text: title :
          width: 84
          color: #c0c0c0
          image-source: /images/ui/checkboxcircle
          image-clip: 0 0 12 12

          $hover !disabled:
            color: #C0C0C0
        
        FlatPanel
          id: name
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          anchors.left: prev.right
          anchors.right: parent.right

    VerticalQtScrollBar
      id: scrollbar
      anchors.top: settings.top
      anchors.right: settings.right
      anchors.bottom: settings.bottom
      step: 24
      pixel-scroll: true

    Panel
      id: colorFrame
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      size: 254 98
      image-source: /images/ui/2pixel-up-frame-borderimage
      image-border: 2
      phantom: true

    Panel
      id: colorMode
      anchors.left: colorFrame.left
      anchors.top: colorFrame.top
      margin-top: -16
      size: 254 18
      layout: horizontalBox

      OutfitColorTab
        id: head
        width: 64
        text: Head
      OutfitColorTab
        id: primary
        width: 63
        text: Primary
      OutfitColorTab
        id: secondary
        width: 64
        text: Secondary
      OutfitColorTab
        id: detail
        width: 63
        text: Detail

    Panel
      id: colorBoxPanel
      anchors.left: colorFrame.left
      anchors.top: colorFrame.top
      margin-left: 4
      margin-top: 3
      size: 247 91
      layout:
        type: grid
        cell-size: 13 13
        cell-spacing: 0
        num-columns: 19
        num-lines: 7

  OutfitPanel
    id: presetButtons
    anchors.top: parent.top
    anchors.left: preview.right
    anchors.right: parent.right
    margin-left: 5
    height: 50
    text: Manage Presets

    OutfitButton
      id: newPreset
      text: New
      anchors.top: parent.top
      anchors.left: parent.left
      width: 43
      font: verdana-bold-8px-native
      @onClick: modules.game_outfit.newPreset()

    OutfitButton
      id: renamePreset
      text: Rename
      anchors.top: parent.top
      anchors.left: newPreset.right
      margin-left: 6
      width: 43
      font: verdana-bold-8px-native
      @onClick: modules.game_outfit.renamePreset()

    OutfitButton
      id: savePreset
      text: Save
      anchors.top: parent.top
      anchors.left: renamePreset.right
      margin-left: 6
      width: 43
      font: verdana-bold-8px-native
      @onClick: modules.game_outfit.savePreset()

    OutfitButton
      id: deletePreset
      text: Delete
      anchors.top: parent.top
      anchors.left: savePreset.right
      margin-left: 6
      width: 43
      font: verdana-bold-8px-native
      @onClick: modules.game_outfit.deletePreset()

  OutfitPanel
    id: listSearch
    anchors.top: parent.top
    anchors.left: preview.right
    anchors.right: parent.right
    margin-left: 5
    height: 50
    text: Filter
    
    QtCheckBox
      id: onlyMine
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: parent.left
      text: "Only mine"
      width: 84

    TextEdit
      id: search
      anchors.left: prev.right
      anchors.right: parent.right
      placeholder: Search by name
      placeholder-color: #c0c0c0c0

  ScrollablePanel
    id: presetsList
    anchors.top: presetButtons.bottom
    anchors.left: presetButtons.left
    anchors.right: parent.right
    anchors.bottom: separator.top
    margin-top: 5
    margin-bottom: 5
    image-source: /images/ui/panel_flat
    image-border: 1
    padding: 4
    padding-right: 15
    vertical-scrollbar: presetsScroll
    auto-focus: none
    visible: false
    layout:
      type: verticalBox
      spacing: 2
  
  VerticalQtScrollBar
    id: presetsScroll
    anchors.top: presetsList.top
    anchors.right: presetsList.right
    anchors.bottom: presetsList.bottom
    step: 80
    pixel-scroll: true
    visible: false

  ScrollablePanel
    id: selectionList
    anchors.top: presetButtons.bottom
    anchors.left: presetButtons.left
    anchors.right: parent.right
    anchors.bottom: separator.top
    margin-top: 5
    margin-bottom: 5
    image-source: /images/ui/panel_flat
    image-border: 1
    padding: 4
    padding-right: 16
    vertical-scrollbar: selectionScroll
    layout:
      type: grid
      cell-size: 104 104
      cell-spacing: 2
      flow: true
  
  VerticalQtScrollBar
    id: selectionScroll
    anchors.top: selectionList.top
    anchors.right: selectionList.right
    anchors.bottom: selectionList.bottom
    step: 80
    pixel-scroll: true

  HorizontalSeparator
    id: separator
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 30

  OutfitButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    text: Cancel
    width: 43
    @onClick: modules.game_outfit.destroy()
  
  OutfitButton
    id: okButton
    anchors.bottom: parent.bottom
    anchors.right: prev.left
    text: Ok
    width: 43
    margin-right: 5
    @onClick: modules.game_outfit.accept()
