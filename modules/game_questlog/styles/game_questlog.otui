QuestLogWindow < UIWindow
  size: 785 637
  font: verdana-bold-11px-native
  color: #909090
  text-align: top
  text-offset: 0 2
  image-source: /images/ui/classic-dialog
  image-border: 4
  image-border-top: 17
  padding: 29 16 16 16

QuestLogFrame < Panel
  color: #00000000
  image-source: /images/ui/2pixel-up-frame-borderimage
  image-border: 2
  padding: 22 7 7 7
  @onTextChange: if self.header then self.header:setText(self:getText()) end

  Label
    id: header
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    margin: -22 -7 0 -7
    height: 17
    font: verdana-bold-11px-native
    color: #909090
    text-align: center
    text-offset: 0 0
    image-source: /images/ui/2pixel-up-header-smoother
    image-border: 2
    image-border-bottom: 1
    phantom: true

TextListQuestLog < Panel
  font: verdana-bold-11px-native
  width: 192
  text-offset: 24 5
  text-align: topLeft
  border-width: 1
  border-color: #00000077
  height: 425
  image-border: 4
  image-border-top: 23
  image-border-bottom: 4
  focusable: true

  TextList
    id: questList
    vertical-scrollbar: spellsScrollBar
    anchors.fill: parent
    padding: 1 13 1 1
    width: 10
    focusable: true
    background-color: #404040
    auto-focus: first

  VerticalQtScrollBar
    id: spellsScrollBar
    anchors.top: questList.top
    anchors.bottom: questList.bottom
    anchors.right: questList.right
    step: 50
    pixels-scroll: true

MultiLineQuestLog < Panel
  font: verdana-bold-11px-native
  width: 192
  text-offset: 24 5
  text-align: topLeft
  border-width: 1
  border-color: #00000077
  height: 425
  image-border: 4
  image-border-top: 23
  image-border-bottom: 4
  focusable: false

  MultilineTextEdit
    id: questList
    vertical-scrollbar: spellsScrollBar
    anchors.fill: parent
    padding: 5 13 5 6
    width: 10
    focusable: false
    editable: false
    text-wrap: true
    background-color: #404040


  VerticalQtScrollBar
    id: spellsScrollBar
    anchors.top: questList.top
    anchors.bottom: questList.bottom
    anchors.right: questList.right
    step: 50
    pixels-scroll: true

TextEditQuestLog < Panel
  height: 18
  TextEdit
    id: SearchEdit
    anchors.fill: parent
    margin-left: 0
    height: 17
    placeholder: Type to search
    placeholder-color: #6E706F
    @onTextChange : onSearchTextChange(self:getText())

  UIWidget
    id: SearchClearButton
    anchors.right: SearchEdit.right
    anchors.top: SearchEdit.top
    margin-top: 1
    margin-right: 2
    image-source: /game_cyclopedia/images/button_clear_search
    image-color: white
    opacity: 0.8
    @onClick: self:getParent():getChildById('SearchEdit'):clearText()
    $hover:
      opacity: 1.0
      image-color: white
    $pressed:
      opacity: 1.0
      image-color: gray

QuestLogLabel < UIWidget
  @onTextChange: modules.game_questlog.fitQuestLogName(self)
  @onGeometryChange: modules.game_questlog.fitQuestLogName(self)
  height: 16
  font: verdana-bold-11px-native
  color: #C0C0C0
  text-align: left
  text-offset: 15 0
  focusable: true
  icon-align: left

  $checked:
    color: #F6F6F6
  CheckBoxButton
    id: iconShow
    anchors.right: parent.right
    icon-source: /game_questlog/images/icon-show-small-on
    width: 15
    height: 15
    margin-right: 30
    visible: false
  CheckBoxButton
    id: iconPin
    anchors.left: prev.right
    icon-source: /game_questlog/images/icon-pin
    height: 15
    width: 15
    margin-left: 3
    visible: false


QuestTrackerMiniWindow < UIMiniWindow
  &save: true
  width: 192
  height: 219
  focusable: false
  image-source: /images/ui/widget-borderimage
  image-border: 4
  image-border-top: 15
  image-repeated: true
  &minimizedHeight: 19

  UIWidget
    id: miniwindowHeader
    image-source: none
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 15
    phantom: true

  UIWidget
    id: miniwindowTopBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 15
    phantom: true

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 4
    minimum: 57
    margin-left: 3
    margin-right: 3

  UIButton
    id: closeButton
    size: 12 12
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 2
    margin-right: 3
    image-size: 12 12
    image-clip: 0 0 12 12
    image-source: /images/ui/miniwindow/exit-button-small-up
    $hover:
      image-clip: 0 0 12 12
    $pressed:
      image-clip: 0 0 12 12
      image-source: /images/ui/miniwindow/exit-button-small-down

  UIButton
    id: minimizeButton
    size: 12 12
    anchors.top: closeButton.top
    anchors.right: closeButton.left
    margin-right: 1
    image-size: 12 12
    image-clip: 0 0 12 12
    image-source: /images/ui/miniwindow/min-button-small-up
    $hover:
      image-clip: 0 0 12 12
    $pressed:
      image-clip: 0 0 12 12
      image-source: /images/ui/miniwindow/min-button-small-down
    $on:
      image-clip: 0 0 12 12
      image-source: /images/ui/miniwindow/max-button-small-up
    $on hover:
      image-clip: 0 0 12 12
      image-source: /images/ui/miniwindow/max-button-small-up
    $on pressed:
      image-clip: 0 0 12 12
      image-source: /images/ui/miniwindow/max-button-small-down

  UIScrollBar
    id: miniwindowScrollBar
    orientation: vertical
    width: 12
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-top: 15
    margin-right: 4
    margin-bottom: 4
    step: 20
    increment: 20
    pixels-scroll: true
    image-source: /images/ui/modal/scrollbar-texture-vertical
    image-clip: 0 0 12 96
    image-border: 0
    image-repeated: true

    UIButton
      id: decrementButton
      anchors.top: parent.top
      anchors.left: parent.left
      size: 12 12
      image-source: /images/ui/modal/scrollbar-buttonup-up
      $pressed:
        image-source: /images/ui/modal/scrollbar-buttonup-down

    UIButton
      id: incrementButton
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      size: 12 12
      image-source: /images/ui/modal/scrollbar-buttondown-up
      $pressed:
        image-source: /images/ui/modal/scrollbar-buttondown-down

    UIButton
      id: sliderButton
      anchors.centerIn: parent
      size: 12 14
      image-source: /images/ui/modal/scrollbar-handle-vertical
      image-border-top: 6
      image-border-bottom: 6

  UIButton
    id: contextMenuButton
    anchors.top: minimizeButton.top
    anchors.right: minimizeButton.left
    margin-right: 5
    size: 12 12
    image-source: /images/ui/miniwindow/button-contextmenu-12x12-idle
    $pressed:
      image-source: /images/ui/miniwindow/button-contextmenu-12x12-pressed

  UIButton
    id: lockButton
    anchors.top: contextMenuButton.top
    anchors.right: contextMenuButton.left
    margin-right: 1
    margin-top: 0
    size: 12 12
    image-size: 12 12
    image-source: /images/ui/miniwindow/buttons
    image-clip: 71 1 12 12

    $hover:
      image-clip: 71 15 12 12

    $pressed:
      image-clip: 71 29 12 12

    $on:
      image-clip: 85 1 12 12

    $on hover:
      image-clip: 85 15 12 12

    $on pressed:
      image-clip: 85 29 12 12

  // RTC bottom-left resize corner.
  RtcMiniBorder
    margin-left: 2
    margin-bottom: 2

QuestLogTracker < QuestTrackerMiniWindow
  id: QuestLogTracker
  height: 94

  UIWidget
    id: miniwindowIcon
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    margin-top: 2
    margin-left: 4
    size: 12 12
    image-source: /images/topbuttons/icon-questtracker-widget
    image-smooth: false

  Label
    id: miniwindowTitle
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    anchors.right: lockButton.left
    margin-top: 1
    margin-left: 20
    margin-right: 2
    font: Verdana Bold-11px
    height: 13
    color: #909090

  ClassicButton
    id: newWindowButton
    anchors.top: contextMenuButton.top
    anchors.right: contextMenuButton.left
    margin-right: 1
    size: 12 12
    icon: /images/ui/miniwindow/icon-additionalwidget

  ScrollablePanel
    id: contentsPanel
    anchors.fill: parent
    margin: 15 16 4 4
    padding: 2
    vertical-scrollbar: miniwindowScrollBar
    layout: verticalBox
    Panel
      id: list
      @onLayoutUpdate: modules.game_questlog.updateTrackerSeparators(self)
      layout:
        type: verticalBox
        fit-children: true

ButtonTrackerMenuOption < UIButton
  text-offset: 5 1
  text-align: left
  color: white
  background-color: alpha
  font: verdana-11px-rounded
  padding: 3 6

  $hover:
    background-color: #ffffff1a

  $disabled:
    color: #c0c0c0ff

QuestTrackerLabel < Panel
  @onDestroy: if self.highlightEvent then self.highlightEvent:cancel() end
  @onHoverChange: modules.game_questlog.onQuestTrackerHover(self, hovered)
  layout:
    type: verticalBox
    fit-children: true

  Panel
    id: separator
    height: 10
    HorizontalSeparator
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter

  Label
    id: questName
    height: 13
    padding-right: 14
    text-align: left
    font: verdana-bold-11px-native
    color: #f7f7f7
    @onGeometryChange: modules.game_questlog.fitTrackerHeading(self)
    @onTextChange: modules.game_questlog.fitTrackerHeading(self)
    &onMousePress: modules.game_questlog.onQuestTrackerDescriptionClick

    UIButton
      id: pinButton
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      size: 12 12
      image-source: /game_questlog/images/icon-pin
      image-size: 5 8
      visible: false
      focusable: false
      !tooltip: tr('Pin this quest line to always show it at the top of the list.')
      $on:
        !tooltip: tr('Remove pin from this quest line.')
      @onClick: modules.game_questlog.toggleQuestTrackerPin(self)

  Label
    id: missionName
    height: 13
    text-align: left
    font: verdana-bold-11px-native
    color: #c0c0c0
    @onGeometryChange: modules.game_questlog.fitTrackerHeading(self)
    @onTextChange: modules.game_questlog.fitTrackerHeading(self)
    &onMousePress: modules.game_questlog.onQuestTrackerDescriptionClick

    UIWidget
      id: completedIcon
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 12 9
      image-source: /game_questlog/images/icon-yes
      visible: false
      phantom: true

  Label
    id: description
    margin-top: 5
    text-align: left
    text-wrap: true
    text-auto-resize: true
    font: verdana-bold-11px-native
    color: #c0c0c0
    &onMousePress: modules.game_questlog.onQuestTrackerDescriptionClick

TrackerWindowsMenu < PopupMenu
  width: 304

  ButtonTrackerMenuOption
    id: remove
    !text: tr('remove')