HuntingMiniWindow < UIMiniWindow
  &save: true
  width: 192
  height: 219
  focusable: false
  image-source: /images/ui/widget-borderimage
  image-border: 4
  image-border-top: 15
  image-repeated: true
  &minimizedHeight: 19

  UIWidget
    id: miniwindowHeader
    image-source: none
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 15
    phantom: true

  UIWidget
    id: miniwindowTopBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 15
    phantom: true

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 4
    minimum: 80
    margin-left: 3
    margin-right: 3

  UIButton
    id: closeButton
    size: 12 12
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 2
    margin-right: 3
    image-size: 12 12
    image-clip: 0 0 12 12
    image-source: /images/ui/miniwindow/exit-button-small-up
    $hover:
      image-clip: 0 0 12 12
    $pressed:
      image-clip: 0 0 12 12
      image-source: /images/ui/miniwindow/exit-button-small-down

  UIButton
    id: minimizeButton
    size: 12 12
    anchors.top: closeButton.top
    anchors.right: closeButton.left
    margin-right: 1
    image-size: 12 12
    image-clip: 0 0 12 12
    image-source: /images/ui/miniwindow/min-button-small-up
    $hover:
      image-clip: 0 0 12 12
    $pressed:
      image-clip: 0 0 12 12
      image-source: /images/ui/miniwindow/min-button-small-down
    $on:
      image-clip: 0 0 12 12
      image-source: /images/ui/miniwindow/max-button-small-up
    $on hover:
      image-clip: 0 0 12 12
      image-source: /images/ui/miniwindow/max-button-small-up
    $on pressed:
      image-clip: 0 0 12 12
      image-source: /images/ui/miniwindow/max-button-small-down

  UIScrollBar
    id: miniwindowScrollBar
    orientation: vertical
    width: 12
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-top: 15
    margin-right: 4
    margin-bottom: 4
    step: 20
    increment: 20
    pixels-scroll: true
    image-source: /images/ui/modal/scrollbar-texture-vertical
    image-clip: 0 0 12 96
    image-border: 0
    image-repeated: true

    UIButton
      id: decrementButton
      anchors.top: parent.top
      anchors.left: parent.left
      size: 12 12
      image-source: /images/ui/modal/scrollbar-buttonup-up
      $pressed:
        image-source: /images/ui/modal/scrollbar-buttonup-down

    UIButton
      id: incrementButton
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      size: 12 12
      image-source: /images/ui/modal/scrollbar-buttondown-up
      $pressed:
        image-source: /images/ui/modal/scrollbar-buttondown-down

    UIButton
      id: sliderButton
      anchors.centerIn: parent
      size: 12 14
      image-source: /images/ui/modal/scrollbar-handle-vertical
      image-border-top: 6
      image-border-bottom: 6

  UIButton
    id: contextMenuButton
    anchors.top: minimizeButton.top
    anchors.right: minimizeButton.left
    margin-right: 5
    size: 12 12
    image-source: /images/ui/miniwindow/button-contextmenu-12x12-idle
    $pressed:
      image-source: /images/ui/miniwindow/button-contextmenu-12x12-pressed

  UIButton
    id: lockButton
    anchors.top: contextMenuButton.top
    anchors.right: contextMenuButton.left
    margin-right: 1
    margin-top: 0
    size: 12 12
    image-size: 12 12
    image-source: /images/ui/miniwindow/buttons
    image-clip: 71 1 12 12

    $hover:
      image-clip: 71 15 12 12

    $pressed:
      image-clip: 71 29 12 12

    $on:
      image-clip: 85 1 12 12

    $on hover:
      image-clip: 85 15 12 12

    $on pressed:
      image-clip: 85 29 12 12

  // RTC bottom-left resize corner.
  RtcMiniBorder
    margin-left: 2
    margin-bottom: 2

HuntingMiniWindow
  id: huntingAnalyserMiniWindow
  &type: 'huntingSessionAnalyser'
  height: 225
  @onExtra: modules.game_analyser.onHuntingExtra(g_window.getMousePosition())
  &save: true
  &autoOpen: false

  UIWidget
    id: miniwindowIcon
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    margin-top: 2
    margin-left: 4
    size: 12 12
    image-source: /images/icons/icon-huntingsessionanalyser-widget
    image-smooth: false

  Label
    id: miniwindowTitle
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    anchors.right: lockButton.left
    margin-top: 1
    margin-left: 18
    margin-right: 2
    font: Verdana Bold-11px
    height: 13
    color: #909090
    !text: tr('Hunt Analyser')

  ScrollablePanel
    id: contentsPanel
    anchors.fill: parent
    margin: 15 16 4 4
    padding: 2
    vertical-scrollbar: miniwindowScrollBar
    Label
      id: sessionLabel
      !text: tr('Session:')
      anchors.top: parent.top
      anchors.left: parent.left
      text-auto-resize: true
      height: 13
      color: #c0c0c0
      font: verdana-bold-11px-native

    Label
      id: session
      !text: tr('00:00h')
      anchors.top: parent.top
      anchors.right: parent.right
      text-auto-resize: true
      height: 13
      color: #c0c0c0
      font: verdana-bold-11px-native

    Label
      id: rawXpLabel
      !text: tr('Raw XP Gain:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 6
      text-auto-resize: true
      height: 13
      color: #c0c0c0
      font: verdana-bold-11px-native
      visible: false

    Label
      id: rawXpGain
      !text: tr('0')
      anchors.top: prev.top
      anchors.right: parent.right
      text-auto-resize: true
      height: 13
      color: #c0c0c0
      font: verdana-bold-11px-native
      visible: false

    Label
      id: xpLabel
      !text: tr('XP Gain:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 6
      text-auto-resize: true
      height: 13
      color: #c0c0c0
      font: verdana-bold-11px-native

    Label
      id: xpGain
      !text: tr('0')
      anchors.top: rawXpGain.bottom
      anchors.right: parent.right
      margin-top: 6
      text-auto-resize: true
      height: 13
      color: #c0c0c0
      font: verdana-bold-11px-native

    Label
      id: rawXpHourLabel
      !text: tr('Raw XP/h:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 6
      text-auto-resize: true
      height: 13
      color: #c0c0c0
      font: verdana-bold-11px-native
      visible: false

    Label
      id: rawXpHour
      !text: tr('0')
      anchors.top: prev.top
      anchors.right: parent.right
      text-auto-resize: true
      height: 13
      color: #c0c0c0
      font: verdana-bold-11px-native
      visible: false

    Label
      id: xpHourLabel
      !text: tr('XP/h:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 6
      text-auto-resize: true
      height: 13
      color: #c0c0c0
      font: verdana-bold-11px-native

    Label
      id: xpHour
      !text: tr('0')
      margin-top: 6
      anchors.top: prev.top
      anchors.right: parent.right
      text-auto-resize: true
      height: 13
      color: #c0c0c0
      font: verdana-bold-11px-native

    Label
      id: lootLabel
      !text: tr('Loot:')
      anchors.top: xpHourLabel.bottom
      anchors.left: parent.left
      margin-top: 6
      text-auto-resize: true
      height: 13
      color: #c0c0c0
      font: verdana-bold-11px-native

    UIWidget
      size: 9 9
      image-auto-resize: true
      image-source: /game_cyclopedia/images/icon_gold
      anchors.top: xpHourLabel.bottom
      anchors.right: parent.right
      margin-top: 9

    Label
      id: loot
      !text: tr('0')
      anchors.top: xpHourLabel.bottom
      anchors.right: prev.left
      margin-top: 6
      margin-right: 4
      text-auto-resize: true
      height: 13
      color: #c0c0c0
      font: verdana-bold-11px-native

    Label
      id: suppliesLabel
      !text: tr('Supplies:')
      anchors.top: lootLabel.bottom
      anchors.left: parent.left
      margin-top: 6
      text-auto-resize: true
      height: 13
      color: #c0c0c0
      font: verdana-bold-11px-native

    UIWidget
      size: 9 9
      image-auto-resize: true
      image-source: /game_cyclopedia/images/icon_gold
      anchors.top: lootLabel.bottom
      anchors.right: parent.right
      margin-top: 9

    Label
      id: supplies
      !text: tr('0')
      anchors.top: lootLabel.bottom
      anchors.right: prev.left
      margin-top: 6
      margin-right: 4
      text-auto-resize: true
      height: 13
      color: #c0c0c0
      font: verdana-bold-11px-native

    Label
      id: balanceLabel
      !text: tr('Balance:')
      anchors.top: suppliesLabel.bottom
      anchors.left: parent.left
      margin-top: 6
      text-auto-resize: true
      height: 13
      color: #c0c0c0
      font: verdana-bold-11px-native

    UIWidget
      size: 9 9
      image-auto-resize: true
      image-source: /game_cyclopedia/images/icon_gold
      anchors.top: suppliesLabel.bottom
      anchors.right: parent.right
      margin-top: 9

    Label
      id: balance
      !text: tr('0')
      anchors.top: suppliesLabel.bottom
      anchors.right: prev.left
      margin-top: 6
      margin-right: 4
      text-auto-resize: true
      height: 13
      color: #44ad25
      font: verdana-bold-11px-native

    Label
      id: damageLabel
      !text: tr('Damage:')
      anchors.top: balanceLabel.bottom
      anchors.left: parent.left
      margin-top: 6
      text-auto-resize: true
      height: 13
      color: #c0c0c0
      font: verdana-bold-11px-native

    Label
      id: damage
      !text: tr('0')
      anchors.top: balanceLabel.bottom
      anchors.right: parent.right
      margin-top: 6
      text-auto-resize: true
      height: 13
      color: #c0c0c0
      font: verdana-bold-11px-native

    Label
      id: damageHourLabel
      !text: tr('Damage/h:')
      anchors.top: damageLabel.bottom
      anchors.left: parent.left
      margin-top: 6
      text-auto-resize: true
      height: 13
      color: #c0c0c0
      font: verdana-bold-11px-native

    Label
      id: damageHour
      !text: tr('0')
      anchors.top: damageLabel.bottom
      anchors.right: parent.right
      margin-top: 6
      text-auto-resize: true
      height: 13
      color: #c0c0c0
      font: verdana-bold-11px-native

    Label
      id: healLabel
      !text: tr('Healing:')
      anchors.top: damageHourLabel.bottom
      anchors.left: parent.left
      margin-top: 6
      text-auto-resize: true
      height: 13
      color: #c0c0c0
      font: verdana-bold-11px-native

    Label
      id: healing
      !text: tr('0')
      anchors.top: damageHourLabel.bottom
      anchors.right: parent.right
      margin-top: 6
      text-auto-resize: true
      height: 13
      color: #c0c0c0
      font: verdana-bold-11px-native

    Label
      id: healHourLabel
      !text: tr('Healing/h:')
      anchors.top: healLabel.bottom
      anchors.left: parent.left
      margin-top: 6
      text-auto-resize: true
      height: 13
      color: #c0c0c0
      font: verdana-bold-11px-native

    Label
      id: healHour
      !text: tr('0')
      anchors.top: healLabel.bottom
      anchors.right: parent.right
      margin-top: 6
      text-auto-resize: true
      height: 13
      color: #c0c0c0
      font: verdana-bold-11px-native

    Label
      id: killedMonstersLabel
      !text: tr('Killed Monsters:')
      anchors.top: healHourLabel.bottom
      anchors.left: parent.left
      margin-top: 6
      text-auto-resize: true
      height: 13
      color: #c0c0c0
      font: verdana-bold-11px-native

    Panel
      height: 13
      anchors.right: parent.right
      id: killedMonsters
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 6
      margin-left: 0

      Label
        id: monster
        !text: tr('None')
        anchors.top: parent.top
        anchors.left: parent.left
        text-auto-resize: true
        height: 13
        color: #c0c0c0
        font: verdana-bold-11px-native

    Label
      id: lootedItemsLabel
      !text: tr('Looted Items:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 6
      text-auto-resize: true
      height: 13
      color: #c0c0c0
      font: verdana-bold-11px-native

    Panel
      height: 13
      anchors.right: parent.right
      id: lootedItems
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 6
      margin-left: 0

      Label
        id: loot
        !text: tr('None')
        anchors.top: parent.top
        anchors.left: parent.left
        text-auto-resize: true
        height: 13
        color: #c0c0c0
        font: verdana-bold-11px-native
