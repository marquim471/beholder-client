VipDialogLabel < Label
  font: verdana-bold-11px-native
  color: #c0c0c0
  height: 13

VipDialogGroupBox < UICheckBox
  height: 13
  font: verdana-bold-11px-native
  color: #c0c0c0
  text-align: left
  text-offset: 16 0
  image-source: /images/ui/checkbox-unchecked
  image-rect: 0 0 12 12
  $checked:
    image-source: /images/ui/checkbox-checked

VipDialogIcon < UICheckBox
  size: 16 16
  image-source: /images/automap/marker-button-up
  icon-source: /images/game/viplist/icons
  icon-size: 12 12
  icon-rect: 2 2 12 12
  icon-clip: 0 0 12 12
  $checked:
    image-source: /images/automap/marker-button-down
  $pressed:
    image-source: /images/automap/marker-button-down

MainWindow
  size: 285 344
  !text: tr('Edit VIP')
  font: verdana-bold-11px-native
  color: #909090
  image-source: /images/ui/classic-dialog
  image-border: 4
  image-border-top: 17
  text-offset: 0 2
  padding: 29 16 16 16

  VipDialogLabel
    id: nameLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right

  HorizontalSeparator
    id: nameSeparator
    anchors.top: nameLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6

  VipDialogLabel
    id: typeLabel
    !text: tr('Select a type:')
    anchors.top: nameSeparator.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 11

  Panel
    id: icons
    anchors.top: typeLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 16
    layout:
      type: horizontalBox
      spacing: 5

    VipDialogIcon
      id: icon0
      icon-clip: 0 0 12 12

    VipDialogIcon
      id: icon1
      icon-clip: 12 0 12 12

    VipDialogIcon
      id: icon2
      icon-clip: 24 0 12 12

    VipDialogIcon
      id: icon3
      icon-clip: 36 0 12 12

    VipDialogIcon
      id: icon4
      icon-clip: 48 0 12 12

    VipDialogIcon
      id: icon5
      icon-clip: 60 0 12 12

    VipDialogIcon
      id: icon6
      icon-clip: 72 0 12 12

    VipDialogIcon
      id: icon7
      icon-clip: 84 0 12 12

    VipDialogIcon
      id: icon8
      icon-clip: 96 0 12 12

    VipDialogIcon
      id: icon9
      icon-clip: 108 0 12 12

    VipDialogIcon
      id: icon10
      icon-clip: 120 0 12 12

  VipDialogLabel
    id: descriptionLabel
    !text: tr('Enter a short description:')
    anchors.top: icons.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 11

  TextEdit
    id: descriptionText
    anchors.top: descriptionLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 50
    padding: 5 14 5 6
    font: verdana-bold-11px-native
    multiline: true
    text-wrap: true
    max-length: 128
    vertical-scrollbar: descriptionScroll

  VerticalQtScrollBar
    id: descriptionScroll
    anchors.top: descriptionText.top
    anchors.bottom: descriptionText.bottom
    anchors.right: descriptionText.right
    margin: 1
    step: 13
    pixel-scroll: true

  FlatPanel
    id: notifyPanel
    anchors.top: descriptionText.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 11
    height: 22
    padding: 5

    VipDialogGroupBox
      id: checkBoxNotify
      !text: tr('Notify on login')
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter

  HorizontalSeparator
    id: groupsSeparator
    anchors.top: notifyPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 11

  VipDialogLabel
    id: groupsLabel
    !text: tr('Member of the following groups:')
    anchors.top: groupsSeparator.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 11

  Panel
    id: groups
    anchors.top: groupsLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: footerSeparator.top
    margin-top: 6
    margin-bottom: 11
    layout:
      type: verticalBox
      spacing: 2

  HorizontalSeparator
    id: footerSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: buttonOK.top
    margin-bottom: 11

  ClassicButton
    id: buttonOK
    !text: tr('Ok')
    font: verdana-bold-8px-native
    anchors.right: buttonCancel.left
    anchors.bottom: parent.bottom
    margin-right: 11

  ClassicButton
    id: buttonCancel
    !text: tr('Cancel')
    font: verdana-bold-8px-native
    anchors.right: parent.right
    anchors.bottom: parent.bottom
