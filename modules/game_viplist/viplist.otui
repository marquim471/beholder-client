VipMiniWindow < UIMiniWindow
  &save: true
  width: 192
  height: 219
  focusable: false
  image-source: /images/ui/widget-borderimage
  image-border: 4
  image-border-top: 15
  image-repeated: true
  &minimizedHeight: 19

  UIWidget
    id: miniwindowHeader
    image-source: none
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 15
    phantom: true

  UIWidget
    id: miniwindowTopBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 15
    phantom: true

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 4
    minimum: 57
    margin-left: 3
    margin-right: 3

  UIButton
    id: closeButton
    size: 12 12
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 2
    margin-right: 3
    image-size: 12 12
    image-clip: 0 0 12 12
    image-source: /images/ui/miniwindow/exit-button-small-up
    $hover:
      image-clip: 0 0 12 12
    $pressed:
      image-clip: 0 0 12 12
      image-source: /images/ui/miniwindow/exit-button-small-down

  UIButton
    id: minimizeButton
    size: 12 12
    anchors.top: closeButton.top
    anchors.right: closeButton.left
    margin-right: 1
    image-size: 12 12
    image-clip: 0 0 12 12
    image-source: /images/ui/miniwindow/min-button-small-up
    $hover:
      image-clip: 0 0 12 12
    $pressed:
      image-clip: 0 0 12 12
      image-source: /images/ui/miniwindow/min-button-small-down
    $on:
      image-clip: 0 0 12 12
      image-source: /images/ui/miniwindow/max-button-small-up
    $on hover:
      image-clip: 0 0 12 12
      image-source: /images/ui/miniwindow/max-button-small-up
    $on pressed:
      image-clip: 0 0 12 12
      image-source: /images/ui/miniwindow/max-button-small-down

  UIScrollBar
    id: miniwindowScrollBar
    orientation: vertical
    width: 12
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-top: 15
    margin-right: 4
    margin-bottom: 4
    step: 20
    increment: 20
    pixels-scroll: true
    image-source: /images/ui/modal/scrollbar-texture-vertical
    image-clip: 0 0 12 96
    image-border: 0
    image-repeated: true

    UIButton
      id: decrementButton
      anchors.top: parent.top
      anchors.left: parent.left
      size: 12 12
      image-source: /images/ui/modal/scrollbar-buttonup-up
      $pressed:
        image-source: /images/ui/modal/scrollbar-buttonup-down

    UIButton
      id: incrementButton
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      size: 12 12
      image-source: /images/ui/modal/scrollbar-buttondown-up
      $pressed:
        image-source: /images/ui/modal/scrollbar-buttondown-down

    UIButton
      id: sliderButton
      anchors.centerIn: parent
      size: 12 14
      image-source: /images/ui/modal/scrollbar-handle-vertical
      image-border-top: 6
      image-border-bottom: 6

  UIButton
    id: contextMenuButton
    anchors.top: minimizeButton.top
    anchors.right: minimizeButton.left
    margin-right: 5
    size: 12 12
    image-source: /images/ui/miniwindow/button-contextmenu-12x12-idle
    $pressed:
      image-source: /images/ui/miniwindow/button-contextmenu-12x12-pressed

  UIButton
    id: lockButton
    anchors.top: contextMenuButton.top
    anchors.right: contextMenuButton.left
    margin-right: 1
    margin-top: 0
    size: 12 12
    image-size: 12 12
    image-source: /images/ui/miniwindow/buttons
    image-clip: 71 1 12 12

    $hover:
      image-clip: 71 15 12 12

    $pressed:
      image-clip: 71 29 12 12

    $on:
      image-clip: 85 1 12 12

    $on hover:
      image-clip: 85 15 12 12

    $on pressed:
      image-clip: 85 29 12 12

  // RTC bottom-left resize corner.
  RtcMiniBorder
    margin-left: 2
    margin-bottom: 2

VipListLabel < GameLabel
  height: 13
  margin-top: 3
  text-align: topLeft
  text-offset: 16 0
  image-rect: 0 0 12 12
  image-clip: 0 0 12 12
  image-source: /images/game/viplist/icons
  font: verdana-bold-11px-native
  phantom: false
  @onGeometryChange: modules.game_viplist.fitVipName(self)
  @onTextChange: modules.game_viplist.fitVipName(self)

  $first:
    margin-top: 0

VipGroupList < UIWidget
  height: 25
  margin-top: 3

  $first:
    margin-top: 0

  Label
    id: group
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 13
    color: #f7f7f7
    font: verdana-bold-11px-native
    text-align: topLeft
    !text: tr('No Group')

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 19

  Panel
    id: panel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 25
    layout:
      type: verticalBox
      fit-children: true

VipMiniWindow
  id: vipWindow
  height: 219
  @onOpen: modules.game_viplist.onMiniWindowOpen()
  @onClose: modules.game_viplist.onMiniWindowClose()
  &save: true

  UIWidget
    id: miniwindowIcon
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    margin-top: 2
    margin-left: 4
    size: 12 12
    image-source: /game_viplist/images/icon-vip-widget
    image-rect: 0 0 12 12
    image-smooth: false

  Label
    id: miniwindowTitle
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    anchors.right: lockButton.left
    margin-top: 1
    margin-left: 20
    margin-right: 2
    font: Verdana Bold-11px
    height: 13
    !text: tr('VIP')
    color: #909090

  ScrollablePanel
    id: contentsPanel
    anchors.fill: parent
    margin: 15 16 4 4
    padding: 2 2 7 2
    vertical-scrollbar: miniwindowScrollBar
    layout: verticalBox
    &onMousePress: modules.game_viplist.onVipListMousePress
