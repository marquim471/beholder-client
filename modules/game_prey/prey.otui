PreyLabel < UILabel
  font: verdana-bold-11px-native
  color: #c0c0c0
  text-align: center
  phantom: true

PreyInset < Panel
  image-source: /images/ui/1pixel-down-frame
  image-border: 1

PreyDarkInset < PreyInset
  UIWidget
    id: backdrop
    anchors.fill: parent
    margin: 1
    image-source: /images/ui/backdrop-dark-grey
    image-repeated: true
    phantom: true

PreyActionButton < ClassicButton
  size: 66 66
  icon-align: center
  @onHoverChange: modules.game_prey.onHover(self, hovered)

PreyProgress < UIProgressBar
  height: 20
  font: verdana-bold-11px-native
  color: #c0c0c0
  text-align: center
  background-color: #363636
  image-source: /images/game/prey/progressbar-orange-large
  image-repeated: true
  @onSetup: self.updateBackground = modules.game_prey.updateProgress; self:setPercent(0); self:updateBackground()

  UIWidget
    anchors.fill: parent
    image-source: /images/ui/1pixel-down-frame
    image-border: 1
    phantom: true

Star < UIWidget
  size: 9 10
  image-source: /images/game/prey/icon-star-active
  @onHoverChange: modules.game_prey.onHover(self, hovered)

NoStar < UIWidget
  size: 9 10
  image-source: /images/game/prey/icon-star-inactive
  @onHoverChange: modules.game_prey.onHover(self, hovered)

PreyCheckBox < UICheckBox
  height: 12
  font: verdana-bold-11px-native
  color: #c0c0c0
  text-align: left
  text-offset: 16 0
  image-rect: 0 0 12 12
  image-source: /images/game/prey/checkbox-unchecked

  $checked:
    image-source: /images/game/prey/checkbox-checked

CardLabel < PreyDarkInset
  height: 20
  &centerContent: true
  @onGeometryChange: modules.game_prey.alignPrice(self)

  UIWidget
    id: cards
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 3
    size: 12 12
    image-source: /images/game/prey/prey-wildcards-icon
    phantom: true

  PreyLabel
    id: text
    anchors.right: cards.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 1
    text-auto-resize: true
    text-align: right
    @onTextChange: modules.game_prey.alignPrice(self:getParent())

GoldLabel < PreyDarkInset
  height: 20
  &centerContent: true
  @onGeometryChange: modules.game_prey.alignPrice(self)

  UIWidget
    id: gold
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 3
    size: 9 9
    image-source: /images/game/prey/icon-goldcoin
    phantom: true

  PreyLabel
    id: text
    anchors.right: gold.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 1
    text-auto-resize: true
    text-align: right
    @onTextChange: modules.game_prey.alignPrice(self:getParent())

  PreyLabel
    id: oldPrice
    anchors.right: text.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 4
    text-auto-resize: true
    color: #707070
    visible: false
    @onTextChange: modules.game_prey.alignPrice(self:getParent())

    UIWidget
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      height: 1
      background-color: #707070
      phantom: true

RerollButton < Panel
  size: 66 88

  Panel
    id: button
    size: 66 66
    anchors.top: parent.top
    anchors.left: parent.left

    PreyActionButton
      id: rerollButton
      anchors.fill: parent
      icon-source: /images/game/prey/prey-list-reroll
      icon-offset: 0 -9
      $pressed:
        icon-offset: 1 -8

    PreyProgress
      id: time
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin: 2
      height: 14
      image-source: /images/game/prey/progressbar-orange-small
      phantom: true

  GoldLabel
    id: price
    anchors.top: button.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2

SelectPreyCreature < Panel
  size: 66 88

  PreyActionButton
    id: pickSpecificPrey
    anchors.top: parent.top
    anchors.left: parent.left
    icon-source: /images/game/prey/prey-choose-prey-disabled

  CardLabel
    id: price
    anchors.top: pickSpecificPrey.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2

BonusReroll < Panel
  size: 66 88

  PreyActionButton
    id: selectPrey
    anchors.top: parent.top
    anchors.left: parent.left
    icon-source: /images/game/prey/prey-bonus-reroll

  CardLabel
    id: price
    anchors.top: selectPrey.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2

ChoosePrey < Panel
  size: 66 88

  PreyActionButton
    id: choosePreyButton
    anchors.fill: parent
    icon-source: /images/game/prey/prey-confirm-monster-selection-disabled

CreatureAndBonus < Panel
  size: 204 156

  PreyInset
    id: creatureFrame
    anchors.top: parent.top
    anchors.left: parent.left
    size: 134 134

  UICreature
    id: creature
    anchors.centerIn: creatureFrame
    size: 128 128
    phantom: true

  UIWidget
    id: noCreature
    anchors.centerIn: creatureFrame
    size: 57 91
    image-source: /images/game/prey/prey-noprey
    phantom: true
    visible: false

  PreyInset
    id: bonus
    anchors.top: parent.top
    anchors.right: parent.right
    size: 66 134

    UIWidget
      id: icon
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 6
      size: 44 92
      image-source: /images/game/prey/prey-bonus-none
      @onHoverChange: modules.game_prey.onHover(self, hovered)

    HorizontalSeparator
      id: separator
      anchors.top: icon.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      margin-left: 5
      margin-right: 5

    Panel
      id: grade
      anchors.top: separator.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 4
      size: 53 22
      layout:
        type: grid
        cell-size: 9 10
        cell-spacing: 2
        num-columns: 5

  PreyProgress
    id: timeLeft
    anchors.top: creatureFrame.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2

ActivePreyPanel < Panel
  size: 204 299

  CreatureAndBonus
    id: creatureAndBonus
    anchors.top: parent.top
    anchors.left: parent.left

  RerollButton
    id: reroll
    anchors.top: creatureAndBonus.bottom
    anchors.left: parent.left
    margin-top: 5

  SelectPreyCreature
    id: select
    anchors.top: reroll.top
    anchors.left: reroll.right
    margin-left: 3

  BonusReroll
    id: choose
    anchors.top: reroll.top
    anchors.right: parent.right

  PreyInset
    id: autoReroll
    anchors.left: parent.left
    anchors.top: reroll.bottom
    margin-top: 5
    size: 176 22

    PreyCheckBox
      id: autoRerollCheck
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 5
      text: Automatic Bonus Reroll
      @onHoverChange: modules.game_prey.onHover('automaticBonusReroll', hovered)

  CardLabel
    id: autoRerollPrice
    anchors.left: autoReroll.right
    anchors.top: autoReroll.top
    margin-left: 2
    size: 26 22

  PreyInset
    id: lockPrey
    anchors.left: parent.left
    anchors.top: autoReroll.bottom
    margin-top: 2
    size: 176 22

    PreyCheckBox
      id: lockPreyCheck
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 5
      text: Lock Prey
      @onHoverChange: modules.game_prey.onHover('preyLock', hovered)

  CardLabel
    id: lockPreyPrice
    anchors.left: lockPrey.right
    anchors.top: lockPrey.top
    margin-left: 2
    size: 26 22

LockedPreyPanel < Panel
  size: 204 299

  CreatureAndBonus
    id: noCreature
    anchors.top: parent.top
    anchors.left: parent.left
    @onHoverChange: modules.game_prey.onHover('noBonusIcon')

  ClassicButton
    id: perm
    anchors.top: noCreature.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    height: 66
    image-source: /images/ui/button-blue-up
    icon-source: /images/game/prey/prey-unlock-permanently
    @onClick: modules.game_mainpanel.toggleStore()
    @onHoverChange: modules.game_prey.onHover('shopPermButton', hovered)
    $pressed:
      image-source: /images/ui/button-blue-down

  ClassicButton
    id: temp
    anchors.top: perm.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    height: 66
    image-source: /images/ui/button-blue-up
    icon-source: /images/game/prey/prey-unlock-temporarily
    @onClick: modules.game_mainpanel.toggleStore()
    @onHoverChange: modules.game_prey.onHover('shopTempButton', hovered)
    $pressed:
      image-source: /images/ui/button-blue-down

InactivePreyPanel < Panel
  size: 204 299

  ChoosePrey
    id: choose
    anchors.right: parent.right
    anchors.bottom: parent.bottom

  RerollButton
    id: reroll
    anchors.bottom: parent.bottom
    anchors.left: parent.left

  SelectPreyCreature
    id: select
    anchors.bottom: parent.bottom
    anchors.left: reroll.right
    margin-left: 3

  FlatPanel
    id: preview
    anchors.left: parent.left
    anchors.right: choose.left
    anchors.bottom: parent.bottom
    margin-right: 6
    height: 88
    padding: 4
    image-source: /images/ui/1pixel-down-frame
    image-border: 1
    visible: false

    Label
      id: placeholder
      anchors.centerIn: parent
      font: verdana-bold-11px-native
      text-align: center
      !text: tr('No creature selected')
      color: #cfcfcf

    UICreature
      id: creature
      anchors.centerIn: parent
      size: 64 64
      phantom: true
      visible: false

  PreyInset
    id: list
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    size: 204 204
    layout:
      type: grid
      cell-size: 68 68
      cell-spacing: 0
      num-columns: 3

  FlatPanel
    id: fullList
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: preview.top
    margin-top: 0
    margin-bottom: 8
    padding: 6
    visible: false
    image-source: /images/ui/1pixel-down-frame
    image-border: 1

    TextEdit
      id: searchEdit
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 0
      height: 20
      padding-left: 1
      padding-right: 18
      placeholder: Type to search
      placeholder-color: #6e706f
      @onTextChange: modules.game_prey.onRaceSearchTextChanged(self)

    UIWidget
      id: searchClearButton
      anchors.top: searchEdit.top
      anchors.right: searchEdit.right
      margin-top: 2
      margin-right: 2
      size: 16 16
      image-source: /images/ui/button-clear-18x18-up
      visible: false
      @onClick: modules.game_prey.onRaceSearchClearClicked(self)

      $pressed:
        image-source: /images/ui/button-clear-18x18-down

    UIScrollArea
      id: entries
      anchors.top: searchEdit.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 4
      margin-bottom: 6
      padding-left: 2
      padding-right: 14
      padding-bottom: 2
      vertical-scrollbar: entriesScroll
      layout:
        type: verticalBox

    VerticalScrollBar
      id: entriesScroll
      anchors.top: entries.top
      anchors.bottom: entries.bottom
      anchors.right: parent.right
      margin-right: 2
      step: 20
      pixel-scroll: true


PreyCreatureBox < UICheckBox
  background-color: alpha
  border-width: 0
  border-color: #ffffff
  @onClick: modules.game_prey.onItemBoxChecked(self)

  UICreature
    id: creature
    phantom: true
    anchors.centerIn: parent
    size: 64 64

  $checked:
    background-color: #80808055
    border-width: 1

  $!checked:
    background-color: alpha
    border-width: 0

PreyCreatureListItem < UICheckBox
  height: 22
  margin-bottom: 2
  padding: 3
  focusable: false
  text-align: left
  font: verdana-bold-11px-native
  color: #c0c0c0
  border-width: 1
  border-color: alpha
  background-color: alpha
  text-offset: 4 0
  size-policy-horizontal: expanding
  @onClick: modules.game_prey.onPreyRaceListItemClicked(self)
  @onHoverChange: modules.game_prey.onPreyRaceListItemHoverChange(self)

  $checked on:
    background-color: #1c4d75ff
    border-color: #6fb1e9ff
    color: #ffffff

  $!checked:
    border-color: alpha


SlotPanel < Panel
  size: 218 328
  image-source: /images/ui/2pixel-up-frame-borderimage
  image-border: 2

  UIWidget
    id: captionBackground
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 17
    image-source: /images/ui/2pixel-up-header-smoother
    image-border: 2
    image-border-bottom: 1
    phantom: true

  PreyLabel
    id: title
    color: #909090
    anchors.fill: captionBackground
    margin-left: 4
    margin-right: 4

  InactivePreyPanel
    id: inactive
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 22

  ActivePreyPanel
    id: active
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 22
    visible: false

  LockedPreyPanel
    id: locked
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 22
    visible: false

PreyTab < ClassicButton
  font: verdana-bold-11px-native
  height: 34
  text-offset: 10 0
  icon-align: left
  icon-offset: 7 0
  $pressed:
    text-offset: 11 1
    icon-offset: 8 1
  $checked:
    text-offset: 11 1
    icon-offset: 8 1

MainWindow
  id: preyWindow
  text: Prey
  text-offset: 0 2
  color: #909090
  image-source: /images/game/prey/dialog-frame-borderimage
  image-border: 4
  image-border-top: 17
  size: 698 564
  font: verdana-bold-11px-native
  padding: 32 16 16 16
  @onEscape: modules.game_prey.hide()
  @onHoverChange: modules.game_prey.onHover(self, hovered)

  PreyInset
    id: tabs
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 36

    PreyTab
      id: creatures
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 1
      margin-left: 1
      anchors.right: parent.right
      margin-right: 1
      text: Prey Creatures
      icon-source: /images/game/prey/icon-prey-preycreature
      checked: true
      @onClick: self:setChecked(true)


  SlotPanel
    id: slot1
    anchors.left: parent.left
    anchors.top: tabs.bottom
    margin-top: 5

  SlotPanel
    id: slot2
    anchors.top: slot1.top
    anchors.left: slot1.right
    margin-left: 7

  SlotPanel
    id: slot3
    anchors.top: slot1.top
    anchors.left: slot2.right
    margin-left: 7

  Panel
    id: description
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: slot1.bottom
    anchors.bottom: bottomSep.top
    margin-top: 5
    margin-bottom: 10
    image-source: /images/ui/2pixel-up-frame-borderimage
    image-border: 2
    font: verdana-bold-11px-native
    color: #c0c0c0
    text-wrap: true
    text-align: topLeft
    text-offset: 5 5

  HorizontalSeparator
    id: bottomSep
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-bottom: 10

  ClassicButton
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    text: Close
    @onClick: modules.game_prey.hide()

  GoldLabel
    id: gold
    &centerContent: false
    anchors.left: parent.left
    anchors.top: closeButton.top
    width: 130

  CardLabel
    id: wildCards
    &centerContent: false
    anchors.left: gold.right
    anchors.top: closeButton.top
    margin-left: 5
    width: 52

  ClassicButton
    id: openStore
    anchors.left: wildCards.right
    anchors.top: closeButton.top
    margin-left: 5
    size: 26 20
    image-source: /images/ui/button-blue-up
    icon-source: /images/game/prey/icon-store-16x10
    @onClick: modules.game_mainpanel.toggleStore()
    $pressed:
      image-source: /images/ui/button-blue-down

PreyCreature < Panel
  height: 22
  margin-top: 3

  UICreature
    id: creature
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    size: 20 20

  UIWidget
    id: noCreature
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    size: 20 20
    image-source: /images/game/prey/prey_inactive

  UIWidget
    id: preyType
    anchors.left: prev.right
    margin-left: 5
    anchors.verticalCenter: prev.verticalCenter
    size: 15 15

  UIWidget
    id: creatureName
    anchors.left: prev.right
    margin-left: 5
    anchors.top: parent.top
    anchors.bottom: prev.bottom
    margin-bottom: 7
    anchors.right: parent.right
    text: Inactive
    font: verdana-11px-rounded
    text-align: left

  ProgressBar
    id: time
    anchors.left: prev.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 2
    height: 6
    background-color: #C28400
    phantom: false

PreyTracker < MiniWindow
  id: preyTracker
  !text: tr('Prey')
  height: 110
  @onOpen: modules.game_prey.onMiniWindowOpen()
  @onClose: modules.game_prey.onMiniWindowClose()
  &save: true

  UIWidget
    id: miniwindowIcon
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    margin-top: 2
    margin-left: 4
    size: 12 12
    image-smooth: false

  Label
    id: miniwindowTitle
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    anchors.right: miniwindowHeader.right
    margin-top: 2
    margin-left: 20
    margin-right: 50
    font: Verdana Bold-11px
    height: 13
    color: #909090

  MiniWindowContents
    id: contentsPanel
    anchors.top: miniwindowTopBar.bottom
    anchors.left: parent.left
    anchors.right: miniwindowScrollBar.left
    anchors.bottom: parent.bottom
    margin-left: 3
    margin-bottom: 3
    margin-top: -2
    margin-right: 1
    vertical-scrollbar: miniwindowScrollBar
    padding-left: 5
    padding-right: 5
    padding-top: 5
    layout: verticalBox

    Label
      !text: tr('Prey Creatures')
      font: verdana-11px-rounded

    HorizontalSeparator
      margin-top: 1

    PreyCreature
      id: slot1
      margin-top: 5

    PreyCreature
      id: slot2

    PreyCreature
      id: slot3
