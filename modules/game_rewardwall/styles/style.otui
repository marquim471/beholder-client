RewardWallWindow < MainWindow
  padding-top: 29

RewardWallFrame < Panel
  font: verdana-bold-11px-native
  color: #c0c0c0
  text-align: top
  text-offset: 0 2
  image-source: /images/ui/2pixel-up-frame-borderimage
  image-border: 2
  padding: 22 7 7 7

  UIWidget
    id: captionBackground
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: -22
    margin-left: -7
    margin-right: -7
    height: 17
    image-source: /images/ui/2pixel-up-header-smoother
    image-border: 2
    image-border-bottom: 1
    phantom: true

  UILabel
    id: caption
    anchors.fill: captionBackground
    font: verdana-bold-11px-native
    text-align: center
    color: #c0c0c0
    phantom: true

ItemReward < UIWidget
  padding-top: 4
  padding-bottom: 4
  padding-left: 8
  padding-right: 8
  height: 40

  Item
    id: item
    size: 32 32
    anchors.top: parent.top
    anchors.left: parent.left
    text-align: center
    phantom: true

  Label
    id: title
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: prev.right
    text-align: left
    width: 190
    margin-left: 10

  SpinBox
    id: number
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: prev.right
    width: 38
    height: 23
    text: 0
    minimum: 0
    maximum: 10
    focusable: true
    @onTextChange:  modules.game_rewardwall.onTextChangeChangeNumber(self:getParent())
    $disabled:
      color: #aaaaaa44

  Label
    id: weight
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: parent.right
    width: 81
    text-align: right
    text-auto-resize: true
    text: 12
    text: 0.00 oz

RewardButton < UIWidget
  size: 66 20
  image-source: /game_rewardwall/images/rewardButton
  image-clip: 0 20 66 20
  $!on:
    image-source: /game_rewardwall/images/rewardButton
    image-clip: 0 0 66 20

RewardButton3 < UIButton
  font: verdana-11px-antialised
  color: #dfdfdfff
  size: 106 23
  text-offset: 0 0
  image-source: /images/ui/button
  image-color: #dfdfdf
  image-clip: 0 0 22 23
  image-border: 3
  opacity: 1.0

  $pressed:
    image-clip: 0 46 22 23
    text-offset: 1 1

  $on:
    border-width-top: 1
    border-color-top: black
    border-width-left: 1
    border-color-left: black
    border-width-bottom: 1
    border-color-bottom: #747474
    border-width-right: 1
    border-color-right: #747474
	
  $!on:
    border-width-top: 0
    border-width-left: 0
    border-width-bottom: 0
    border-width-right: 0
	
  UIWidget
    id:ditherpattern
    image-source: /game_rewardwall/images/ditherpattern
    image-border: 3
    anchors.fill: parent
    phantom: true
    visible:false
    size: 106 23
    margin-top: 1
    margin-left: 2
    margin-right:2
    margin-bottom:2


imgBonuses < UIWidget
  border-width-top: 1
  border-color-top: black
  border-width-left: 1
  border-color-left: black
  border-width-bottom: 1
  border-color-bottom: #747474
  border-width-right: 1
  border-color-right: #747474
  image-source: /images/ui/test/button-verydarkgrey-down
  icon-source: /game_rewardwall/images/icon-restingareabonuseslevels
  size: 64 70

  UIWidget
    id:ditherpattern
    image-source: /game_rewardwall/images/ditherpattern
    image-border: 3
    anchors.fill: parent
    phantom: true
    margin-top: 1
    margin-left: 1
    margin-right: 1
    margin-bottom: 1
    visible:false
  UIWidget
    id:ditherpattern
    image-source: /game_rewardwall/images/icon-banner-premium
    phantom: true
    anchors.top: parent.top
    anchors.left: parent.left
    visible:false

OfferBuyPrice < FlatPanel
  anchors.top: prev.bottom
  anchors.left: prev.left
  anchors.right: prev.right
  margin-top: 4
  image-color: #A0A0A0
  height: 21
  text: 0
  text-align: center
  color: #C0C0C0
  icon: /images/store/coin
  icon-size: 12 12
  icon-offset-x: 88
  icon-offset-y: 4
  focusable: false
  $disabled:
    color: #ff1f1f
  $on:
    icon: /images/store/coin_second

GoldLabel2 < UIWidget
  image-source: /images/ui/1pixel-down-frame
  image-border: 1

  UIWidget
    anchors.fill: parent
    margin: 1
    image-source: /images/ui/backdrop-dark-grey
    image-repeated: true
    phantom: true

  UIWidget
    id: gold
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    size: 11 11
    margin-right: 3
    image-source: /game_rewardwall/images/icon-daily-reward-joker
    phantom: true

  UILabel
    id: text
    anchors.right: gold.left
    anchors.verticalCenter: parent.verticalCenter
    text-align: right
    text-auto-resize: true
    font: verdana-bold-11px-native
    color: #c0c0c0
    phantom: true

TESDTSTST < Panel
  id: actions
  size: 68 95
  margin-top: -9
  layout:
    type: verticalBox
    align-right: true
    spacing: -5
  Button
    id: yourself
    size: 68 68
  GoldLabel
    id: yourself
    height: 20
    size: 68 22
    margin-top: 10

TextListWithScroll < Panel
  font: verdana-11px-antialised
  width: 192
  text-offset: 24 5
  text-align: topLeft
  border-width: 1
  border-color: #00000077
  height: 425
  image-border: 4
  image-border-top: 23
  image-border-bottom: 4
  focusable: false
  TextList
    id: List
    vertical-scrollbar: spellsScrollBar
    anchors.fill: parent
    padding: 1
    width: 10
    focusable: false
    background-color: #404040
  VerticalQtScrollBar
    id: spellsScrollBar
    anchors.top: prev.top
    anchors.bottom: prev.bottom
    anchors.right: prev.right
    step: 50
    pixels-scroll: true

RewardWallActionButton < ClassicButton

RewardWallPremiumButton < ClassicButton
  size: 128 37
  image-source: /images/ui/button-blue-up
  icon-source: /game_rewardwall/images/icon-get-premium

  $pressed:
    image-source: /images/ui/button-blue-down

  $on:
    image-source: /images/ui/button-grey-down
    icon-source: /game_rewardwall/images/icon-have-premium

RewardWallTimer < UIWidget
  size: 66 20
  image-source: /images/ui/1pixel-down-frame
  image-border: 1

  UIWidget
    anchors.fill: parent
    margin: 1
    image-source: /images/ui/backdrop-dark-grey
    image-repeated: true
    phantom: true

  UIWidget
    id: progress
    anchors.left: parent.left
    anchors.top: parent.top
    margin: 1
    size: 64 18
    image-source: /game_rewardwall/images/progressbar-orange-large
    image-border: 1
    phantom: true

  UILabel
    id: caption
    anchors.fill: parent
    text-align: center
    icon-align: center
    font: verdana-bold-11px-native
    color: #dfdfdf
    phantom: true

RewardWallInfoColumn < Panel
  width: 243
  height: 91
  visible: false

  UILabel
    id: heading
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 13
    font: verdana-bold-11px-native
    text-align: topLeft
    phantom: true

  UILabel
    id: details
    anchors.top: heading.bottom
    margin-top: 1
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    font: verdana-bold-11px-native
    text-align: topLeft
    text-wrap: true
    phantom: true

RewardWallInfoPanel < Panel
  image-source: /images/ui/2pixel-up-frame-borderimage
  image-border: 2
  font: verdana-bold-11px-native
  text-align: topLeft
  text-offset: 7 7
  text-wrap: true

  RewardWallInfoColumn
    id: free
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 7
    margin-top: 7

  RewardWallInfoColumn
    id: premium
    anchors.top: parent.top
    anchors.right: parent.right
    margin-right: 7
    margin-top: 7
    width: 244
