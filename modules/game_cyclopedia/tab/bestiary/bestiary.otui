BestiaryCharmSlot < UIWidget
  size: 48 48
  @onClick: modules.game_cyclopedia.Cyclopedia.selectBestiaryCharmSlot(self:getId() == 'MajorCharmSlot' and 1 or 2)
  UIWidget
    id: Background
    anchors.fill: parent
    margin: 1
    image-source: /images/game/cyclopedia/charm-slot
    image-smooth: true
    phantom: true
  UIWidget
    id: Selection
    anchors.fill: parent
    border: 1 white
    visible: false
    phantom: true
  UIWidget
    id: Backdrop
    size: 44 44
    anchors.centerIn: parent
    image-source: /images/game/cyclopedia/charm-slot-filled
    image-smooth: true
    visible: false
    phantom: true
  UIWidget
    id: Grade
    size: 46 46
    anchors.centerIn: parent
    visible: false
    phantom: true
  UIWidget
    id: Icon
    size: 32 32
    anchors.centerIn: parent
    image-source: /game_cyclopedia/images/charms/monster-bonus-effects
    image-clip: 0 0 32 32
    visible: false
    phantom: true

BestiaryCharmComboPopupMenuButton < ComboBoxPopupMenuButton
  font: verdana-bold-11px-native
  text-offset: 5 0
  margin: 0
  $hover !disabled:
    color: #f4f4f4
    background-color: #80808055
  $checked:
    color: #f4f4f4
    background-color: #80808055

BestiaryCharmComboPopupMenu < ComboBoxPopupMenu
  image-source: /images/ui/button-9grid-pressed
  image-clip: 0 0 98 40
  image-border: 1
  image-repeated: true

BestiaryCharmCombo < UIComboBox
  height: 20
  font: verdana-bold-11px-native
  color: #c0c0c0
  text-align: center
  text-offset: -10 1
  image-source: /images/ui/button-9grid-idle
  image-border: 1
  image-repeated: true
  $on:
    image-source: /images/ui/button-9grid-pressed
  $disabled:
    color: #707070
  UIWidget
    id: Arrow
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 20
    image-source: /images/game/cyclopedia/charm-dropdown-idle
    phantom: true

UIWidget
  id: Cat2
  anchors.fill: parent
  visible: false

  CyclopediaDialogButton
    id: SearchButton
    enabled: false
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 35
    !text: tr('Search')
    @onClick:  modules.game_cyclopedia.Cyclopedia.BestiarySearch(self:getText())
  TextEdit
    id: SearchEdit
    size: 150 16
    image-source: /images/game/cyclopedia/search-field
    image-border: 0
    anchors.right: SearchButton.left
    anchors.bottom: SearchButton.bottom
    margin-bottom: 2
    margin-right: 6
    placeholder: Type to search
    placeholder-color: #707070
    font: verdana-11px-antialised
    placeholder-font: verdana-11px-antialised
    color: #C0C0C0
    padding-left: 5
    padding-right: 2
    padding-top: 2
    max-length: 29
    @onTextChange: modules.game_cyclopedia.Cyclopedia.BestiarySearchText(self:getText())
  UIWidget
    id: PageValue
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: SearchButton.verticalCenter
    margin-left: 15
    margin-top: 1
    height: 13
    text-auto-resize: true
    font: verdana-bold-11px-native
    text-align: center
    !text: tr('1 / 1')
    color: #c0c0c0
  ClassicButton
    id: NextPageButton
    size: 20 20
    image-clip: 0 0 98 40
    image-repeated: true
    anchors.left: PageValue.right
    anchors.top: SearchButton.top
    margin-left: 11
    icon-source: /images/game/cyclopedia/page-next
    @onClick: modules.game_cyclopedia.Cyclopedia.changeBestiaryPage(false, true)
    $disabled:
      icon-source: /game_cyclopedia/images/icon-right-arrow-disabled
  ClassicButton
    id: PrevPageButton
    size: 20 20
    image-clip: 0 0 98 40
    image-repeated: true
    anchors.right: PageValue.left
    anchors.top: SearchButton.top
    margin-right: 11
    icon-source: /game_cyclopedia/images/icon-left-arrow
    @onClick: modules.game_cyclopedia.Cyclopedia.changeBestiaryPage(true, false)
    $disabled:
      icon-source: /game_cyclopedia/images/icon-left-arrow-disabled
  UIWidget
    id: BackPageButton
    size: 20 20
    anchors.right: PrevPageButton.left
    anchors.top: SearchButton.top
    margin-right: 11
    image-source: /game_cyclopedia/images/button_back
    $pressed:
      image-source: /game_cyclopedia/images/button_back_pressed
    $checked:
      image-source: /game_cyclopedia/images/button_back_pressed
    $disabled:
      image-source: /game_cyclopedia/images/button_back_disabled
  Panel
    id: ListBase
    anchors.bottom: SearchButton.top
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    margin-bottom: 5
    UIWidget
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 1
      image-source: /images/ui/modal/1pixel-down-frame-top
      image-repeated: true
      phantom: true
    UIWidget
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      margin-top: 1
      width: 1
      image-source: /images/ui/modal/1pixel-down-frame-left
      image-repeated: true
      phantom: true
    UIWidget
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-top: 1
      width: 1
      image-source: /images/ui/modal/1pixel-down-frame-right
      image-repeated: true
      phantom: true
    UIWidget
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-left: 1
      margin-right: 1
      height: 1
      image-source: /images/ui/modal/1pixel-down-frame-bottom
      image-repeated: true
      phantom: true
    UIScrollArea
      id: CategoryList
      anchors.fill: parent
      padding-left: 7
      padding-top: 4
      layout:
        type: grid
        cell-size: 126 119
        cell-spacing: 6
        flow: true
    UIScrollArea
      id: CreatureList
      anchors.fill: parent
      padding-left: 7
      padding-top: 4
      visible: false
      layout:
        type: grid
        cell-size: 126 119
        cell-spacing: 6
        flow: true
    UIWidget
      id: CreatureInfo
      anchors.fill: parent
      image-source: /images/ui/2pixel_up_frame_borderimage
      image-border: 2
      image-repeated: true
      visible: false
      UIWidget
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        height: 17
        image-source: /images/ui/2pixel-up-header-smoother
        image-border-left: 2
        image-border-right: 2
        image-border-top: 2
        image-border-bottom: 1
        image-repeated: true
        phantom: true
      Label
        id: Caption
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin-left: 4
        margin-right: 4
        height: 17
        font: verdana-bold-11px-native
        text-align: center
        color: #909090
        phantom: false
      UIWidget
        id: AnimusMastery
        anchors.top: parent.top
        anchors.left: parent.left

        margin-top: 18
        margin-left: 3
        image-source: /game_cyclopedia/images/indicator_soulcore
      UIWidget
        id: LeftBase
        anchors.left: parent.left
        anchors.top: parent.top
        anchors.bottom: parent.verticalCenter
        margin-top: 20
        margin-left: 5
        width: 125
        phantom: true
        BestiaryTrackCheck
          id: TrackCheck
          anchors.bottom: parent.bottom
          anchors.horizontalCenter: parent.horizontalCenter
          !text: tr('Track Kills')
          text-auto-resize: true
          @onCheckChange: modules.game_cyclopedia.Cyclopedia.onBestiaryTrackCheckChange(self)
        UICreature
          id: Sprite
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 30
          size: 96 96
      BestiaryDetailProgress
        id: ProgressBorder2
        anchors.left: LeftBase.right
        anchors.top: parent.top
        margin-top: 40
        margin-left: 80
        size: 62 20
      BestiaryDetailProgress
        id: ProgressBorder1
        anchors.right: ProgressBorder2.left
        anchors.bottom: ProgressBorder2.bottom
        margin-right: 2
        size: 63 20
      BestiaryDetailProgress
        id: ProgressBorder3
        anchors.left: ProgressBorder2.right
        anchors.bottom: ProgressBorder2.bottom
        margin-left: 2
        size: 63 20
      UIWidget
        id: ProgressBack
        anchors.left: ProgressBorder1.left
        anchors.top: ProgressBorder1.top
        margin-left: 1
        margin-top: 1
        height: 18
        image-source: /game_cyclopedia/images/bestiary/progressbar-orange-large
        image-repeated: true
        phantom: true
      UIWidget
        id: ProgressBack33
        anchors.left: ProgressBorder2.left
        anchors.top: ProgressBorder2.top
        margin-left: 1
        margin-top: 1
        height: 18
        image-source: /game_cyclopedia/images/bestiary/progressbar-orange-large
        image-repeated: true
        phantom: true
      UIWidget
        id: ProgressBack55
        anchors.left: ProgressBorder3.left
        anchors.top: ProgressBorder3.top
        margin-left: 1
        margin-top: 1
        height: 18
        image-source: /game_cyclopedia/images/bestiary/progressbar-orange-large
        image-repeated: true
        phantom: true
      Label
        id: ProgressValue
        anchors.centerIn: ProgressBorder2
        font: verdana-bold-11px-native
        color: #c0c0c0

        text-auto-resize: true
        !text: tr('0')
      Label
        id: TotalLabel
        anchors.bottom: ProgressBorder2.top
        anchors.horizontalCenter: ProgressBorder2.horizontalCenter

        margin-bottom: 3
        size: 190 13
        font: verdana-bold-11px-native
        text-align: center
        !text: tr('Total Kills')
        color: #c0c0c0
      UIWidget
        id: StarBase
        anchors.left: ProgressBorder1.left
        anchors.top: ProgressBorder2.bottom
        margin-top: 4
        image-source: /images/game/cyclopedia/star-inactive
        image-repeated: true
        width: 53
      UIWidget
        id: StarFill
        anchors.left: ProgressBorder1.left
        anchors.top: StarBase.top
        image-source: /images/game/cyclopedia/star-active
        image-repeated: true
        width: 53
      UIWidget
        id: DiamondBase
        anchors.left: ProgressBorder1.left
        anchors.top: StarFill.bottom
        margin-top: 5
        image-source: /images/game/cyclopedia/diamond-inactive
        image-repeated: true
        width: 42
      UIWidget
        id: DiamondFill
        anchors.left: ProgressBorder1.left
        anchors.top: DiamondBase.top
        image-source: /images/game/cyclopedia/diamond-active
        image-repeated: true
        width: 42
      UIWidget
        id: SubTextLabel
        anchors.top: DiamondBase.bottom
        anchors.left: DiamondBase.left
        margin-top: 5
        size: 9 13
        image-rect: 0 2 9 9
        font: verdana-bold-11px-native
        color: #c0c0c0
        text-align: left
 
      UIWidget
        id: BonusIcon
        anchors.top: SubTextLabel.bottom
        anchors.left: SubTextLabel.left
        margin-top: 5
        image-source: /game_cyclopedia/images/bestiary/icons/monster-icon-bonuspoints
      Label
        id: BonusValue
        anchors.verticalCenter: BonusIcon.verticalCenter
        anchors.left: BonusIcon.right
        margin-left: 5
        text-auto-resize: true
        !text: tr('?')
        color: #C7C7C7
      UIWidget
        id: CharmBase
        anchors.bottom: LeftBase.bottom
        anchors.left: BonusIcon.left
        image-source: /images/ui/panel_flat
        image-border: 10
        size: 45 45
      Button
        id: SelectButton
        size: 70 20
        anchors.left: CharmBase.right
        anchors.bottom: CharmBase.bottom
        margin-left: 5
        !text: tr('Select')
        //font: verdana-bold-8px-antialiased
        text-offset: 0 -1
        color: #C0C0C0
      ComboBox
        id: CharmSelector
        anchors.left: SelectButton.left
        anchors.right: ProgressBorder3.right
        anchors.top: CharmBase.top
        text-align: center
        enabled: false
        @onSetup: |
          self:addOption("?")
      UIWidget
        id: BalanceBase
        anchors.right: CharmSelector.right
        anchors.left: SelectButton.right
        anchors.bottom: SelectButton.bottom
        height: 20
        margin-left: 5
        image-source: /images/ui/item
        image-border: 10
        UIWidget
          id: GoldIcon
          anchors.right: parent.right
          anchors.verticalCenter: parent.verticalCenter
          margin-right: 5
          image-source: /game_cyclopedia/images/icon_gold
        Label
          id: GoldBalance
          anchors.right: GoldIcon.left
          anchors.verticalCenter: parent.verticalCenter
          margin-right: 5
          text-align: right
          !text: '?'
      Label
        id: CharmLabel
        anchors.bottom: CharmBase.top
        anchors.left: CharmBase.left
        margin-bottom: 3
        text-auto-resize: true
        !text: tr('Charm Selection:')
        color: #C7C7C7
      UIWidget
        id: CharmsPanel
        size: 190 70
        anchors.left: ProgressBorder1.left
        anchors.bottom: ItemsBase.top
        margin-bottom: 11
        visible: false
        BestiaryCharmSlot
          id: MajorCharmSlot
          anchors.top: parent.top
          anchors.left: parent.left
        BestiaryCharmSlot
          id: MinorCharmSlot
          anchors.top: parent.top
          anchors.left: parent.left
          margin-left: 50
        CyclopediaDialogButton
          id: ActionButton
          size: 90 20
          anchors.top: parent.top
          anchors.left: parent.left
          margin-left: 100
          margin-top: 14
          text: Assign Charm
          enabled: false
          @onClick: modules.game_cyclopedia.Cyclopedia.actionBestiaryCharm()
        ModernCharmFrame
          id: Cost
          size: 90 20
          anchors.top: parent.top
          anchors.left: parent.left
          margin-left: 100
          margin-top: 27
          visible: false
          UIWidget
            anchors.fill: parent
            margin: 1
            image-source: /images/ui/backdrop-dark-grey
            image-repeated: true
            phantom: true
          UIWidget
            id: Icon
            anchors.left: Value.right
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 1
            margin-top: 1
            image-source: /game_cyclopedia/images/icon_gold
          Label
            id: Value
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            margin-top: 1
            height: 13
            font: verdana-bold-11px-native
            text-auto-resize: true
            color: #c0c0c0
        BestiaryCharmCombo
          id: Selector
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 50
          enabled: false
          @onOptionChange: modules.game_cyclopedia.Cyclopedia.updateBestiaryCharms()
      VerticalSeparator
        id: IconsSep
        anchors.horizontalCenter: ProgressBorder2.horizontalCenter
        anchors.top: ProgressBorder2.bottom
        anchors.bottom: CharmLabel.top
        margin-top: 3
        margin-left: 20
      UIWidget
        id: Icon1
        !tooltip: tr('Hit Points')
        anchors.top: IconsSep.top
        anchors.left: IconsSep.right
        margin-top: 2
        margin-left: 5
        image-source: /game_cyclopedia/images/bestiary/icons/monster-icon-hitpoints
      Label
        id: Value1
        font: verdana-bold-11px-native
        anchors.verticalCenter: Icon1.verticalCenter
        anchors.left: Icon1.right
        margin-left: 6
        text-auto-resize: true
        !text: tr('?')
        color: #c0c0c0
      UIWidget
        id: Icon2
        !tooltip: tr('Experience')
        anchors.top: Icon1.bottom
        anchors.left: IconsSep.right
        margin-top: 7
        margin-left: 5
        image-source: /game_cyclopedia/images/bestiary/icons/monster-icon-experience
      Label
        id: Value2
        font: verdana-bold-11px-native
        anchors.verticalCenter: Icon2.verticalCenter
        anchors.left: Icon2.right
        margin-left: 6
        text-auto-resize: true
        !text: tr('?')
        color: #c0c0c0
      UIWidget
        id: Icon3
        !tooltip: tr('Speed')
        anchors.top: Icon2.bottom
        anchors.left: IconsSep.right
        margin-top: 7
        margin-left: 5
        image-source: /game_cyclopedia/images/bestiary/icons/monster-icon-speed
      Label
        id: Value3
        font: verdana-bold-11px-native
        anchors.verticalCenter: Icon3.verticalCenter
        anchors.left: Icon3.right
        margin-left: 6
        text-auto-resize: true
        !text: tr('?')
        color: #c0c0c0
      UIWidget
        id: Icon4
        !tooltip: tr('Armor')
        anchors.top: Icon3.bottom
        anchors.left: IconsSep.right
        margin-top: 7
        margin-left: 5
        image-source: /game_cyclopedia/images/bestiary/icons/monster-icon-armor
      Label
        id: Value4
        font: verdana-bold-11px-native
        anchors.verticalCenter: Icon4.verticalCenter
        anchors.left: Icon4.right
        margin-left: 6
        text-auto-resize: true
        !text: tr('?')
        color: #c0c0c0
      UIWidget
        id: Icon5
        !tooltip: tr('Mitigation')
        anchors.top: Icon4.bottom
        anchors.left: IconsSep.right
        margin-top: 7
        margin-left: 5
        image-source: /game_cyclopedia/images/bestiary/icons/monster-icon-mitigation
      Label
        id: Value5
        font: verdana-bold-11px-native
        anchors.verticalCenter: Icon5.verticalCenter
        anchors.left: Icon5.right
        margin-left: 6
        text-auto-resize: true
        !text: tr('?')
        color: #c0c0c0
      UIWidget
        id: LocationField
        anchors.left: BalanceBase.right
        anchors.bottom: BalanceBase.bottom
        anchors.right: parent.right
        height: 100
        image-source: /images/ui/textedit
        image-border: 10
        margin-left: 10
        margin-right: 5
        ScrollablePanel
          id: Textlist
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 5
          margin-bottom: 5
          margin-left: 5
          margin-right: 20
          padding-left: 1
          vertical-scrollbar: TextlistScrollBar
          layout: verticalBox
          UIWidget
            id: Text
            text-auto-resize: true
            text-align: left
            text-wrap: true
            !text: '?'
            color: #C7C7C7
        VerticalScrollBar
          id: TextlistScrollBar
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          anchors.right: parent.right
          margin-right: 2
          margin-top: 2
          margin-bottom: 2
          step: 37
          pixels-scroll: true
      Label
        id: LocationLabel
        anchors.left: LocationField.left
        anchors.bottom: LocationField.top
        margin-bottom: 3
        text-auto-resize: true
        !text: tr('Location(s)') .. ':'
        color: #C7C7C7
      UIWidget
        id: PhysicalResist
        image-source: /game_cyclopedia/images/bestiary/icons/monster-icon-physical-resist
        anchors.left: ProgressBorder3.right
        anchors.top: parent.top
        margin-top: 35
        margin-left: 10
      BestiaryResistProgress
        id: PhysicalProgress
        anchors.left: PhysicalResist.right
        anchors.bottom: PhysicalResist.bottom
        margin-left: 5
      UIWidget
        id: EarthResist
        image-source: /game_cyclopedia/images/bestiary/icons/monster-icon-earth-resist
        anchors.left: PhysicalProgress.right
        anchors.top: PhysicalResist.top
        margin-left: 5
      BestiaryResistProgress
        id: EarthProgress
        anchors.left: EarthResist.right
        anchors.bottom: EarthResist.bottom
        margin-left: 5
      UIWidget
        id: FireResist
        image-source: /game_cyclopedia/images/bestiary/icons/monster-icon-fire-resist
        anchors.left: EarthProgress.right
        anchors.top: PhysicalResist.top
        margin-left: 5
      BestiaryResistProgress
        id: FireProgress
        anchors.left: FireResist.right
        anchors.bottom: FireResist.bottom
        margin-left: 5
      UIWidget
        id: DeathResist
        image-source: /game_cyclopedia/images/bestiary/icons/monster-icon-death-resist
        anchors.left: FireProgress.right
        anchors.top: PhysicalResist.top
        margin-left: 5
      BestiaryResistProgress
        id: DeathProgress
        anchors.left: DeathResist.right
        anchors.bottom: DeathResist.bottom
        margin-left: 5
      UIWidget
        id: EnergyResist
        image-source: /game_cyclopedia/images/bestiary/icons/monster-icon-energy-resist
        anchors.left: ProgressBorder3.right
        anchors.top: PhysicalResist.bottom
        margin-top: 10
        margin-left: 10
      BestiaryResistProgress
        id: EnergyProgress
        anchors.left: EnergyResist.right
        anchors.bottom: EnergyResist.bottom
        margin-left: 5
        
        
      UIWidget
        id: HolyResist
        image-source: /game_cyclopedia/images/bestiary/icons/monster-icon-holy-resist
        anchors.left: EnergyProgress.right
        anchors.top: EnergyResist.top
        margin-left: 5
      BestiaryResistProgress
        id: HolyProgress
        anchors.left: HolyResist.right
        anchors.bottom: HolyResist.bottom
        margin-left: 5
      UIWidget
        id: IceResist
        image-source: /game_cyclopedia/images/bestiary/icons/monster-icon-ice-resist
        anchors.left: HolyProgress.right
        anchors.top: EnergyResist.top
        margin-left: 5
      BestiaryResistProgress
        id: IceProgress
        anchors.left: IceResist.right
        anchors.bottom: IceResist.bottom
        margin-left: 5
      UIWidget
        id: HealingResist
        image-source: /game_cyclopedia/images/bestiary/icons/monster-icon-healing-resist
        anchors.left: IceProgress.right
        anchors.top: EnergyResist.top
        margin-left: 5
      BestiaryResistProgress
        id: HealingProgress
        anchors.left: HealingResist.right
        anchors.bottom: HealingResist.bottom
        margin-left: 5
      UIWidget
        id: ItemsBase
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: LeftBase.bottom
        anchors.bottom: parent.bottom
        margin-top: 5
        margin-bottom: 5
        margin-left: 5
        margin-right: 5
        image-source: /game_cyclopedia/images/panel_flat
        image-border: 10
        UIScrollArea
          id: Itemlist
          anchors.fill: parent
          margin-bottom: 5
          margin-left: 5
          margin-right: 20
          padding-top: 5
          auto-focus: first
          vertical-scrollbar: ItemlistScrollBar
          layout: verticalBox
        VerticalScrollBar
          id: ItemlistScrollBar
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          anchors.right: parent.right
          margin-right: 2
          margin-top: 2
          margin-bottom: 2
          step: 37
          pixels-scroll: true
