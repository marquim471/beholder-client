  UIWidget
    id: FilterBase
    anchors.left: StarBase.right
    anchors.right: parent.right
    anchors.top: StarBase.top
    margin-left: 6
    height: 68
    image-source: /images/ui/2pixel_up_frame_borderimage
    image-border: 2
    image-repeated: true
    UIWidget
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 17
      image-source: /images/ui/2pixel-up-header-smoother
      image-border-left: 2
      image-border-right: 2
      image-border-top: 2
      image-border-bottom: 1
      image-repeated: true
      phantom: true
    Label
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-left: 4
      margin-right: 4
      height: 17
      font: verdana-bold-11px-native
      text-align: center
      color: #909090
      !text: tr('Filter')
    BestiaryTrackCheck
      id: BaneCheck
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 7
      margin-top: 24
      !text: tr('Bane')
      !tooltip: tr('')
      checked: true
      @onClick: modules.game_cyclopedia.Cyclopedia.changeBosstiaryFilter(self, self:isChecked())
      $checked:
        !tooltip: tr('')
      text-offset: 29 0
    UIWidget
      id: BaneIcon
      anchors.left: BaneCheck.left
      anchors.top: BaneCheck.top
      margin-left: 14
      margin-top: 1
      image-source: /game_cyclopedia/images/boss/icon_bane
    BestiaryTrackCheck
