  ModernCharmFrame
    id: ListBase
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: FilterBase.bottom
    anchors.bottom: parent.bottom
    margin-bottom: 30
    margin-top: 10
    UIScrollArea
      id: BossList
      anchors.fill: parent
      margin-left: 5
      margin-top: 5
      margin-right: 1
      margin-bottom: 5
      layout:
        type: grid
        cell-size: 159 151
        cell-spacing: 5
        flow: true
  UITextEdit
    id: SearchEdit
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 5
    size: 150 20
    background-color: #363636
    color: #c0c0c0
    selection-background-color: #808080
    cursor: none
    blink-speed: 600
    font: verdana-bold-11px-native
    placeholder-font: verdana-bold-11px-native
    padding-left: 5
    padding-top: 2
    padding-bottom: 3
    padding-right: 20
    max-length: 29
    placeholder: Type to search
    placeholder-color: #707070
    @onTextChange: modules.game_cyclopedia.Cyclopedia.scheduleBosstiarySearch(self:getText())
  ModernCharmFrame
    anchors.fill: SearchEdit
    phantom: true
  ClassicButton
    id: SearchClearButton
    anchors.right: SearchEdit.right
    anchors.top: SearchEdit.top
    margin-top: 1
    margin-right: 1
    size: 18 18
    image-clip: 0 0 98 40
    image-repeated: true
    icon-source: /images/ui/icon-erase-small
    icon-offset: 0 0
    !tooltip: tr('Clear all text from the search field.')
    @onClick: modules.game_cyclopedia.Cyclopedia.BosstiarySearchText("", true)
  Label
    id: PageValue
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: SearchEdit.top
    margin-top: 4
    height: 13
    text-auto-resize: true
    font: verdana-bold-11px-native
    text-align: center
    !text: tr('1 / 1')
    color: #c0c0c0
  ClassicButton
    id: NextPageButton
    anchors.left: PageValue.right
    anchors.top: SearchEdit.top
    margin-left: 11
    size: 20 20
    image-clip: 0 0 98 40
    image-repeated: true
    icon-offset: 0 0
    icon-source: /images/game/cyclopedia/page-next
    @onClick: modules.game_cyclopedia.Cyclopedia.changeBosstiaryPage(false, true)
    $disabled:
      icon-source: /images/game/actionbar/icon-arrow-right-disabled
  ClassicButton
    id: PrevPageButton
    anchors.right: PageValue.left
    anchors.top: SearchEdit.top
    margin-right: 11
    size: 20 20
    image-clip: 0 0 98 40
    image-repeated: true
    icon-offset: 0 0
    icon-source: /images/game/actionbar/icon-arrow
    @onClick: modules.game_cyclopedia.Cyclopedia.changeBosstiaryPage(true, false)
    $disabled:
      icon-source: /images/game/actionbar/icon-arrow-disabled
