            text: x0

        MiniPanel
          id: taskBoard
          image-source: /images/ui/outfits/minipanel
          image-border: 5
          color: #C0C0C0
          height: 50
          margin: 5
          margin-bottom: 1
          text: Task Board

          Label
            id: permanentWeeklyTaskExpansion
            anchors.top: parent.top
            anchors.left: parent.left
            margin-top: 2
            text-auto-resize: true
            color: #909090
            text: Permanent Weekly Task Expansion:

          Label
            id: permanentWeeklyTaskExpansionValue
            anchors.top: parent.top
            anchors.right: parent.right
            margin-top: 2
            margin-right: 5
            text-auto-resize: true
            text: No

        MiniPanel
          id: dailyReward
          image-source: /images/ui/outfits/minipanel
          image-border: 5
          color: #C0C0C0
          height: 50
          margin: 5
          margin-bottom: 1
          text: Daily Reward

          Label
            id: InstantRewardAccess
            anchors.top: parent.top
            anchors.left: parent.left
            margin-top: 2
            text-auto-resize: true
            color: #909090
            text: Collection Tokens:

          Label
            id: InstantRewardAccessValue
            anchors.top: parent.top
            anchors.right: parent.right
            margin-top: 2
            margin-right: 5
            text-auto-resize: true
            text: x0

        MiniPanel
          id: CharmPanel
          image-source: /images/ui/outfits/minipanel
          image-border: 5
          color: #C0C0C0
          height: 50
          margin: 5
          margin-bottom: 1
          text: Charms

          Label
            id: CharmExpansion
            anchors.top: parent.top
            anchors.left: parent.left
            margin-top: 2
            text-auto-resize: true
            color: #909090
            text: Charm Expansion:

          Label
            id: CharmExpansionValue
            anchors.top: parent.top
            anchors.right: parent.right
            margin-top: 2
            margin-right: 5
            text-auto-resize: true
            text: No

        MiniPanel
          id: hirelings
          image-source: /images/ui/outfits/minipanel
          image-border: 5
          color: #C0C0C0
          height: 82
          margin: 5
          margin-bottom: 1
          text: Hirelings

          Label
            id: PurchasedHireLings
            anchors.top: parent.top
            anchors.left: parent.left
            margin-top: 2
            text-auto-resize: true
            color: #909090
            text: Purchased Hirelings:

          Label
            id: PurchasedHirelingsValue
            anchors.top: parent.top
            anchors.right: parent.right
            margin-top: 2
            margin-right: 5
            text-auto-resize: true
            text: x0

          Label
            id: hirelingjobs
            anchors.top: PurchasedHireLings.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            margin-top: 2
            text-wrap: true
            color: #909090
            text: Hireling Jobs: None

          Label
            id: hirelingOutfits
            anchors.top: hirelingjobs.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            margin-top: 2
            text-wrap: true
            color: #909090
            text: Hireling Outfits: None

        MiniPanel
          id: houseItems
          image-source: /images/ui/outfits/minipanel
          image-border: 5
          color: #C0C0C0
          height: 52
          margin: 5
          margin-bottom: 5
          text: Available House Items

          Label
            id: NoneLabel
            anchors.top: parent.top
            anchors.left: parent.left
            margin-top: 2
            margin-left: 10
            text-auto-resize: true
            text: None

          Panel
            id: PurchasedHouseItems
            anchors.top: parent.top
            anchors.left: parent.left
            anchors.right: parent.right
            margin-top: 5
            layout:
              type: grid
              cell-size: 220 78
              flow: true

      VerticalScrollBar
        id: ListScrollbarStoreSummary
        anchors.top: List.top
        anchors.right: List.right
        anchors.bottom: List.bottom
        margin: 1
        step: 80
        pixel-scroll: true
  UIWidget
    id: CharacterTitles
    anchors.top: CharacterBase.top
    anchors.left: CharacterBase.right
    anchors.bottom: OptionsBase.bottom
    anchors.right: parent.right
    margin-left: 11
    visible: false

    BorderBox
      id: CurrentTitle
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 52
      Label
        id: Caption
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 4
        margin-left: 8
        !text: tr('Current Title')
        color: #C0C0C0
        text-auto-resize: true
      Label
        id: Value
        anchors.left: parent.left
        anchors.right: Clear.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 24
        margin-right: 4
        margin-top: 8
        !text: tr('No title selected')
        color: #C0C0C0
        text-align: center
      Button
        id: Clear
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 8
        margin-top: 8
        size: 16 16
        icon-source: /images/ui/icon-delete
        tooltip: Clear current title
        @onClick: modules.game_cyclopedia.Cyclopedia.selectCharacterTitle(0)

    BorderBox
      id: AvailableTitles
      anchors.top: CurrentTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 5
      Label
        id: Caption
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 4
        margin-left: 8
        !text: tr('Available Titles')
        color: #C0C0C0
        text-auto-resize: true
      Panel
        id: Filters
        anchors.top: Caption.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        height: 48
        margin-top: 5
        margin-left: 7
        margin-right: 7
        CheckBoxCircle
          id: all
          anchors.top: parent.top
          anchors.left: parent.left
          !text: tr('All')
          checked: true
          @onClick: modules.game_cyclopedia.Cyclopedia.characterTitleFilter(self)
        CheckBoxCircle
          id: permanent
          anchors.top: parent.top
          anchors.left: all.right
          margin-left: 8
          !text: tr('Permanent')
          @onClick: modules.game_cyclopedia.Cyclopedia.characterTitleFilter(self)
        CheckBoxCircle
          id: temporary
          anchors.top: all.bottom
          anchors.left: parent.left
          margin-top: 3
          !text: tr('Temporary')
          @onClick: modules.game_cyclopedia.Cyclopedia.characterTitleFilter(self)
        CheckBoxCircle
          id: unlocked
          anchors.top: permanent.bottom
          anchors.left: permanent.left
          margin-top: 3
          !text: tr('Unlocked')
          @onClick: modules.game_cyclopedia.Cyclopedia.characterTitleFilter(self)
        CheckBoxCircle
          id: locked
          anchors.top: parent.top
          anchors.left: permanent.right
          margin-left: 8
          !text: tr('Locked')
          @onClick: modules.game_cyclopedia.Cyclopedia.characterTitleFilter(self)
        TextEdit
          id: SearchEdit
          anchors.right: parent.right
          anchors.verticalCenter: parent.verticalCenter
          width: 155
          height: 18
          max-length: 29
          !placeholder: tr('Type to search...')
          @onTextChange: modules.game_cyclopedia.Cyclopedia.characterTitleSearch(self:getText())
        Button
          id: SearchClear
          anchors.right: SearchEdit.right
          anchors.verticalCenter: SearchEdit.verticalCenter
          size: 16 16
          icon-source: /images/ui/icon-erase-small
          @onClick: SearchEdit:clearText()
      Panel
        id: Header
        anchors.top: Filters.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-left: 7
        margin-top: 4
        height: 18
        background-color: #363636
        Label
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 5
          !text: tr('Name')
          color: #C0C0C0
        Label
          anchors.right: parent.right
          anchors.verticalCenter: parent.verticalCenter
          width: 80
          !text: tr('Unlocked')
          text-align: center
          color: #C0C0C0
        Label
          anchors.right: prev.left
          anchors.verticalCenter: parent.verticalCenter
          width: 80
          !text: tr('Permanent')
          text-align: center
          color: #C0C0C0
      UIScrollArea
        id: List
        anchors.top: Header.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-left: 7
        margin-bottom: 7
        vertical-scrollbar: ListScrollbar
        layout:
          type: verticalBox
      VerticalScrollBar
        id: ListScrollbar
        anchors.top: Header.top
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-right: 7
        margin-bottom: 7
        step: 20
        pixel-scroll: true

  BorderBox
    id: OffenceStats
    anchors.top: CharacterBase.top
    anchors.left: CharacterBase.right
    anchors.bottom: OptionsBase.bottom
    anchors.right: parent.right
    margin-left: 11
    visible: false

    
    UIScrollArea
      id: content
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: scrollbar.left
      anchors.bottom: parent.bottom
      vertical-scrollbar: scrollbar


      UIWidget
        id: statsContainer
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        height: 350
        layout:
          type: anchor

        VerticalSeparator
          id: separator
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          margin-top: 5
          margin-bottom: 5

        Panel
          id: leftPanel
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: separator.right
          margin-top: 5
          margin-left: 5
          layout:
            type: verticalBox
            fit-children: true
            
        Panel
          id: rightPanel
          anchors.top: leftPanel.top
          anchors.left: separator.left
          anchors.right: parent.right
          margin-top: 1
          layout:
            type: verticalBox
            fit-children: true

    VerticalScrollBar
      id: scrollbar
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      step: 48
      pixel-scroll: true


  BorderBox
    id: DeffenceStats
    anchors.top: CharacterBase.top
    anchors.left: CharacterBase.right
    anchors.bottom: OptionsBase.bottom
    anchors.right: parent.right
    margin-left: 11
    visible: false

    VerticalSeparator
      id: separator
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-bottom: 5


    Panel
      id: leftPanel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: separator.right
      margin-top: 5
      margin-left: 5
      height: 350
      layout:
        type: verticalBox
        spacing: 2

    Panel
      id: rightPanel
      anchors.top: prev.top
      anchors.left: separator.left
      anchors.right: parent.right
      margin-top: 1
      height: 350
      layout:
        type: verticalBox
        spacing: 2

  BorderBox
    id: MiscStats
    anchors.top: CharacterBase.top
    anchors.left: CharacterBase.right
    anchors.bottom: OptionsBase.bottom
    anchors.right: parent.right
    margin-left: 11
    visible: false

    UIScrollArea
      id: miscStatsContent
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      vertical-scrollbar: miscStatsScrollbar
      margin-right: 0

      UIWidget
        id: miscStatsContainer
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        layout:
          type: anchor
        
        VerticalSeparator
          id: miscStatsSeparator
          width: 2
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          margin-top: 5
          margin-bottom: 5

        Panel
          id: leftPanel
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: miscStatsSeparator.right
          margin-top: 5
          margin-left: 5
          layout:
            type: verticalBox
            fit-children: true

        Panel
          id: rightPanel
          anchors.top: parent.top
          anchors.left: miscStatsSeparator.right
          anchors.right: parent.right
          margin-top: 5
          margin-left: 10
          layout:
            type: verticalBox
            fit-children: true

          Label
            id: activeConcoctions
            !text: tr("Active Concoctions:")
            color: #C0C0C0
            text-auto-resize: true 
          Panel
            id: concoctions
            margin-top: 3
            layout:
              type: grid
              cell-size: 34 34
              cell-spacing: 5
              num-columns: 5
              fit-children: true

          Label
            id: consumables
            !text: tr("Consumable Cooldowns:")
            margin-top: 10
            color: #C0C0C0
            text-auto-resize: true 
          Panel
            id: cooldowns
            margin-top: 3
            layout:
              type: grid
              cell-size: 34 34
              cell-spacing: 5
              num-columns: 5
              fit-children: true

    VerticalScrollBar
      id: miscStatsScrollbar
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      step: 48
      pixel-scroll: true
      @onMaximumChange: |
        local visible = self:getMaximum() > 0
        self:setVisible(visible)
        self:getParent():getChildById('miscStatsContent'):setMarginRight(visible and self:getWidth() or 0)
