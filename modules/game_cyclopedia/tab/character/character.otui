      id: magiclevel
      anchors.top: skillsLabel.bottom
      anchors.left: separator.left
      anchors.right: parent.right
      margin-top: 10
      SkillNameLabel
        !text: tr('Magic')
        color: #C0C0C0
      SkillValueLabel
      SkillCharacterIcon
        anchors.left: parent.left
        image-clip: 27 0 9 9
      SkillCharacterPercentPanel
        anchors.left: icon.right
        margin-top: 15
        margin-left: 5
        background-color: #00C000
