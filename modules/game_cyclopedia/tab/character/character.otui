CharacterInspectionButton < UIButton
  size: 33 33
  image-source: /game_cyclopedia/images/character/inspect-player
  image-clip: 0 0 33 33
  image-border: 1
  $pressed:
    image-clip: 0 33 33 33

CharacterInspectionDescription < Label
  height: 22
  text-align: topLeft
  text-wrap: true
  text-auto-resize: false
  color: #c0c0c0

CharacterInspectionImbuement < UIWidget
  size: 64 64
  image-source: /images/game/imbuing/slot_inactive
  image-clip: 0 0 64 64
  phantom: true


InfoLabel < Panel
  height: 20
  Label
    id: text
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    text-auto-resize: true
    color: #C0C0C0
  Label
    id: value
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    text-auto-resize: true
    color: #C1C1C1

InfoLeftLabel < Panel
  height: 15
  Label
    id: value
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    text-auto-resize: true
    color: #929292
    margin-left: 20

BlessingLabel < Panel
  height: 20
  Label
    id: text
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    text-auto-resize: true
    color: #C0C0C0
  Label
    id: value
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    text-auto-resize: true
    color: #C1C1C1

CharacterEffectItem < Item
  Label
    id: duration
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    phantom: true
    font: verdana-11px-rounded
    color: white
MiscItems < UIWidget
  size: 34 34
  Item
    id: item
    anchors.fill: parent
    phantom: true
    virtual: true

UIWidget
  id: Cat6
  anchors.fill: parent
  visible: false
  UIWidget
    id: CharacterBase
    anchors.left: parent.left
    anchors.top: parent.top
    image-source: /game_cyclopedia/images/character/header
    image-border-top: 17
    image-border-left: 4
    image-border-right: 4
    image-border-bottom: 4
    font: Verdana Bold-11px
    size: 164 119
    color: #929292
    text-offset: 0 1
    text-align: top
    !text: tr('Player Name')
    change-cursor-image: true
    cursor: pointer
    @onClick: modules.game_cyclopedia.Cyclopedia.selectCharacterPage()
    Label
      id: Title
      font: Verdana Bold-11px
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 19
      margin-left: 7
      margin-right: 7
      height: 0
      text-align: top
      text-wrap: false
      color: #C1C1C1
      visible: false
    Label
      id: Level
      font: Verdana Bold-11px
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.bottom: Vocation.top
      height: 14
      !text: tr('Level: 1')
      text-auto-resize: true
      text-align: center
      color: #C1C1C1
    Label
      id: Vocation
      font: Verdana Bold-11px
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.bottom: parent.bottom
      margin-bottom: 7
      height: 14
      !text: tr('Knight')
      text-auto-resize: true
      text-align: center
      color: #C1C1C1
    UICreature
      id: Outfit
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: Title.bottom
      size: 64 64
      phantom: true
  UIWidget
    id: OptionsBase
    anchors.left: CharacterBase.left
    anchors.top: CharacterBase.bottom
    anchors.bottom: parent.bottom
    margin-top: 6
    margin-bottom: 53
    image-source: /images/ui/2pixel_up_frame_borderimage_dark
    image-border: 2
    padding: 2

    width: 164

  BorderBox
    id: InfoBase
    image-source: /game_cyclopedia/images/character/panel
    image-border: 1
    anchors.top: CharacterBase.top
    anchors.left: CharacterBase.right
    anchors.bottom: OptionsBase.bottom
    anchors.right: parent.right
    margin-left: 11
    Panel
      id: outfitPanel
      anchors.left: parent.left
      anchors.top: parent.top
      size: 110 146
      visible: false
      UICreature
        id: Sprite
        anchors.fill: parent
    Panel
      id: inventoryPanel
      anchors.left: parent.left
      anchors.top: parent.top
      size: 110 146
      HeadSlot
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 4
        margin-left: 40
      BodySlot
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 40
        margin-left: 40
      LegSlot
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 76
        margin-left: 40
      FeetSlot
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 112
        margin-left: 40
      NeckSlot
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 22
        margin-left: 4
      LeftSlot
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 58
        margin-left: 4
      FingerSlot
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 94
        margin-left: 4
      BackSlot
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 22
        margin-left: 76
      RightSlot
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 58
        margin-left: 76
      AmmoSlot
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 94
        margin-left: 76
    CharacterInspectionButton
      id: CharacterButton
      anchors.left: inventoryPanel.right
      anchors.top: parent.top
      margin-top: 4
      margin-left: 6
      &state: 1
      @onClick: modules.game_cyclopedia.Cyclopedia.characterButton(self)
    Button
      id: WheelButton  
      anchors.left: CharacterButton.right  
      anchors.top: CharacterButton.top  
      margin-left: 3
      size: 33 33
      icon-source: /game_cyclopedia/images/button_wheel  
      @onClick: modules.game_wheel.toggle()
    Panel
      id: Imbuements
      size: 206 66
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 98
      margin-right: 4
      layout:
        type: horizontalBox
        spacing: -5
        align-right: true
    BorderBox
      id: DetailsBase
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-left: 4
      margin-right: 4
      margin-bottom: 4
      height: 240
      background-color: #363636
      UIScrollArea
        id: List
        vertical-scrollbar: ListScrollbar
        anchors.fill: parent
        size: 200 60
        padding-left: 2
        padding-top: 2
        padding-bottom: 2
        layout:
          type: verticalBox
          spacing: 2
          fit-children: false
        UIWidget
          !text: tr('Status: Loading, please wait...')
          color: #BEBEBE
      VerticalScrollBar
        id: ListScrollbar
        anchors.top: List.top
        anchors.right: List.right
        anchors.bottom: List.bottom
        step: 80
        pixel-scroll: true
    Label
      id: InspectLabel
      anchors.bottom: DetailsBase.top
      anchors.left: DetailsBase.left
      margin-bottom: 5
      text-auto-resize: true
      !text: tr('You are inspecting') .. ": " .. "Player Name"
      color: #BEBEBE
  BorderBox
    id: CharacterStats
    anchors.top: CharacterBase.top
    anchors.left: CharacterBase.right
    anchors.bottom: OptionsBase.bottom
    anchors.right: parent.right
    margin-left: 11
    visible: false
    VerticalSeparator
      id: separator
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-bottom: 5
    CharacterSkillBase
      id: level
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: separator.right
      SkillNameLabel
        !text: tr('Level')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0
      SkillCharacterPercentPanel
        background-color: #C00000
    CharacterSkillBase
      id: experience
      anchors.top: level.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-top: 10
      SkillNameLabel
        !text: tr('Experience')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0
    CharacterSkillBase
      id: expGainRate
      anchors.top: experience.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-top: 1
      SkillNameLabel
        !text: tr('XP Gain Rate')
        color: #C0C0C0
      SkillValueLabel
        color: #44AD25
    UIWidget
      id: xpBoostButton
      image-source: /images/ui/button-storexp
      anchors.horizontalCenter: level.horizontalCenter
      anchors.top: expGainRate.bottom
      @onClick: modules.game_shop.toggle()
      $pressed:
        image-source: /images/ui/button-storexp-pressed
    HorizontalSeparator
      id: leftSeparator
      anchors.top: expGainRate.bottom
      anchors.left: parent.left
      anchors.right: xpBoostButton.left
      margin-top: 5
      margin-left: 5
    HorizontalSeparator
      id: rightSeparator
      anchors.top: leftSeparator.top
      anchors.left: xpBoostButton.right
      anchors.right: separator.right
      margin-left: 1
      margin-right: 5
    CharacterSkillBase
      id: health
      anchors.top: xpBoostButton.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-top: 10
      SkillNameLabel
        !text: tr('Hit Points')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0
    CharacterSkillBase
      id: mana
      anchors.top: health.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-top: 1
      SkillNameLabel
        !text: tr('Mana')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0
    CharacterSkillBase
      id: soul
      anchors.top: mana.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-top: 1
      SkillNameLabel
        !text: tr('Soul Points')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0
    CharacterSkillBase
      id: capacity
      anchors.top: soul.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-top: 1
      SkillNameLabel
        !text: tr('Capacity')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0
    CharacterSkillBase
      id: speed
      anchors.top: capacity.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-top: 1
      SkillNameLabel
        !text: tr('Speed')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0
    CharacterSkillBase
      id: food
      anchors.top: speed.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-top: 1
      SkillNameLabel
        !text: tr('Food')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0
    CharacterSkillBase
      id: stamina
      anchors.top: food.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-top: 1
      SkillNameLabel
        !text: tr('Stamina')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0
      SkillCharacterPercentPanel
        background-color: green
    CharacterSkillBase
      id: trainer
      anchors.top: stamina.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-top: 5
      SkillNameLabel
        !text: tr('Offline Training')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0
      SkillCharacterPercentPanel
        background-color: #C00000

    HorizontalSeparator
      id: leftSeparator2
      anchors.top: trainer.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-top: 5
      margin-left: 5

    CharacterSkillBase
      id: accountStatus
      anchors.top: leftSeparator2.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-top: 10
      SkillNameLabel
        !text: tr('Account Status')
        color: #C0C0C0
      SkillValueLabel
        !text: tr('33')
        color: #C0C0C0
    CharacterSkillBase
      id: accountOnline
      anchors.top: accountStatus.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-top: 5
      SkillNameLabel
        !text: tr('Account Premium')
        color: #C0C0C0
      SkillValueLabel
        !text: tr('33')
        color: #C0C0C0
    CharacterSkillBase
      id: loyaltyTitle
      anchors.top: accountOnline.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-top: 5
      SkillNameLabel
        !text: tr('Loyalty Title')
        color: #C0C0C0
      SkillValueLabel
        !text: tr('33')
        color: #C0C0C0

    Label
      id: skillsLabel
      !text: tr('Skills')
      color: #C0C0C0
      anchors.top: level.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-left: 125
