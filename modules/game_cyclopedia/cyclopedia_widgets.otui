SelectBossBossSlots < UICheckBox
  size: 90 105
  border: 0 white
  @onClick: modules.game_cyclopedia.Cyclopedia.bossSlotSelectBoss(self)
  $checked:
    border: 1 white
  $!checked:
    border: 0 white
  UIWidget
    anchors.fill: parent
    margin: 1
    image-source: /images/ui/2pixel_up_frame_borderimage
    image-border: 2
    image-repeated: true
    phantom: true
    UIWidget
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 17
      image-source: /images/ui/2pixel-up-header-smoother
      image-border-left: 2
      image-border-right: 2
      image-border-top: 2
      image-border-bottom: 1
      image-repeated: true
      phantom: true
  Label
    id: Name
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 5
    margin-right: 5
    margin-top: 1
    height: 17
    font: verdana-bold-11px-native
    text-align: center
    color: #909090
    phantom: true
  UICreature
    id: Sprite
    size: 64 64
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.top
    margin-top: 33
    phantom: true
  UIWidget
    id: TypeIcon
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 8
    margin-top: 23
    image-source: images/boss/icon_bane
SlotBossSlots < UIWidget
  size: 222 360
  image-source: /images/ui/2pixel_up_frame_borderimage
  image-border: 2
  image-repeated: true
  UIWidget
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 17
    image-source: /images/ui/2pixel-up-header-smoother
    image-border-left: 2
    image-border-right: 2
    image-border-top: 2
    image-border-bottom: 1
    image-repeated: true
    phantom: true
  Label
    id: Title
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 4
    margin-right: 4
    height: 17
    font: verdana-bold-11px-native
    color: #909090
    text-align: center
  Label
    id: LockLabel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 5
    margin-right: 5
    margin-top: 162
    font: verdana-bold-11px-native
    color: #c0c0c0
    text-wrap: true
    trim-line-end-spaces: true
    text-vertical-auto-resize: true
    !text: tr('Unlocks if you reach the Prowess level for any boss')
    text-align: center
    visible: true
  UIWidget
    id: SelectBoss
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 5
    margin-right: 5
    margin-top: 22
    margin-bottom: 7
    visible: false
    UIWidget
      id: ListBase
      size: 212 281
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 0
      margin-left: 0
      UIScrollArea
        id: List
        vertical-scrollbar: ListScrollbar
        anchors.fill: parent
        margin-top: 1
        margin-bottom: 1
        margin-left: 1
        margin-right: 13
        padding: 5
        padding-bottom: 9
        layout:
          type: grid
          cell-size: 90 105
          cell-spacing: 2
          flow: true
      ModernCharmFrame
        anchors.fill: parent
        phantom: true
      UIScrollBar
        id: ListScrollbar
        orientation: vertical
        width: 12
        anchors.top: parent.top
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-top: 1
        margin-right: 1
        margin-bottom: 1
        step: 20
        increment: 20
        pixels-scroll: true
        image-source: /images/ui/modal/scrollbar-texture-vertical
        image-border: 0
        image-repeated: true
        UIButton
          id: decrementButton
          anchors.top: parent.top
          anchors.left: parent.left
          size: 12 12
          image-source: /images/ui/modal/scrollbar-buttonup-up
          $pressed:
            image-source: /images/ui/modal/scrollbar-buttonup-down
        UIButton
          id: incrementButton
          anchors.bottom: parent.bottom
          anchors.right: parent.right
          size: 12 12
          image-source: /images/ui/modal/scrollbar-buttondown-up
          $pressed:
            image-source: /images/ui/modal/scrollbar-buttondown-down
        UIButton
          id: sliderButton
          anchors.centerIn: parent
          size: 12 14
          image-source: /images/ui/modal/scrollbar-handle-vertical
          image-border-top: 6
          image-border-bottom: 6
    UITextEdit
      id: SearchEdit
      height: 20
      anchors.top: ListBase.bottom
      anchors.right: ListBase.right
      anchors.left: ListBase.left
      margin-top: 6
      background-color: #363636
      color: #c0c0c0
      selection-background-color: #808080
      cursor: none
      blink-speed: 600
      font: verdana-bold-11px-native
      placeholder-font: verdana-bold-11px-native
      padding-left: 5
      padding-top: 2
      padding-bottom: 3
      padding-right: 20
      placeholder: Type to search
      placeholder-color: #707070
      max-length: 255
      @onTextChange: modules.game_cyclopedia.Cyclopedia.scheduleBossSlotSearch(self:getText(), self)
    ModernCharmFrame
      anchors.fill: SearchEdit
      phantom: true
    ClassicButton
      id: SearchClearButton
      anchors.right: SearchEdit.right
      anchors.top: SearchEdit.top
      margin-top: 1
      margin-right: 1
      size: 18 18
      image-clip: 0 0 98 40
      image-repeated: true
      icon-source: /images/ui/icon-erase-small
      icon-offset: 0 0
      !tooltip: tr('Clear all text from the search field.')
      @onClick: modules.game_cyclopedia.Cyclopedia.SelectBossSearchText("", true, self)
    ClassicButton
      id: SelectButton
      size: 43 20
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      !text: tr('Select')
      font: verdana-bold-8px-native
      image-clip: 0 0 98 40
      image-repeated: true
      text-offset: 0 0
      color: #C0C0C0
      enabled: false
      margin-bottom: 0
      margin-right: 0
  UIWidget
    id: ActivedBoss
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 7
    margin-right: 7
    margin-top: 22
    margin-bottom: 7
    visible: false
    UICreature
      id: Sprite
      size: 64 64
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      margin-top: 7
    UIWidget
      id: TypeIcon
      anchors.right: Sprite.left
      margin-right: 11
      anchors.top: Sprite.top
      image-source: images/boss/icon_bane
    BossSlotProgress
      id: Progress
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 113
    Label
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      margin-top: 96
      height: 13
      font: verdana-bold-11px-native
      text-auto-resize: true
      !text: tr('Total Kills')
      color: #c0c0c0
    Label
      id: EquipmentLabel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      margin-top: 159
      font: verdana-bold-11px-native
      color: #c0c0c0
      text-wrap: true
      trim-line-end-spaces: true
      text-vertical-auto-resize: true
      text-align: center
    UIWidget
      id: ValueBackground
      size: 128 20
      anchors.bottom: parent.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      UIWidget
        anchors.fill: parent
        margin: 1
        image-source: /images/ui/backdrop-dark-grey
        image-repeated: true
        phantom: true
      ModernCharmFrame
        anchors.fill: parent
        phantom: true
    Label
      id: Value
      anchors.horizontalCenter: ValueBackground.horizontalCenter
      anchors.top: ValueBackground.top
      margin-left: -4
      margin-top: 4
      height: 13
      font: verdana-bold-11px-native
      text-auto-resize: true
      !text: ('0')
      text-align: center
    UIWidget
      image-source: /game_cyclopedia/images/icon_gold
      anchors.left: Value.right
      anchors.verticalCenter: Value.verticalCenter
      margin-left: 1
      margin-top: 0
    ClassicButton
      id: RemoveButton
      height: 20
      anchors.bottom: ValueBackground.bottom
      anchors.right: ValueBackground.right
      anchors.left: ValueBackground.left
      margin-bottom: 25
      !text: tr('Remove')
      font: verdana-bold-8px-native
      image-clip: 0 0 98 40
      image-repeated: true
      text-offset: 0 0
      color: #C0C0C0
