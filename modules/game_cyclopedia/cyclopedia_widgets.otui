CharacterTitle < UICheckBox
  height: 20
  background-color: #414141
  focusable: true
  $hover:
    background-color: #505050
  $checked:
    background-color: #585858
  Label
    id: Name
    anchors.left: parent.left
    anchors.right: PermanentColumn.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    margin-right: 18
    color: #C0C0C0
    text-align: left
    text-auto-resize: false
  Button
    id: Action
    anchors.right: PermanentColumn.left
    anchors.verticalCenter: parent.verticalCenter
    size: 14 14
    margin-right: 3
    icon-source: /images/ui/icon-edit
    tooltip: Select title
  VerticalSeparator
    id: PermanentColumn
    anchors.right: UnlockedColumn.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    width: 80
    UIWidget
      id: Permanent
      anchors.centerIn: parent
      size: 11 11
  VerticalSeparator
    id: UnlockedColumn
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    width: 80
    UIWidget
      id: Unlocked
      anchors.centerIn: parent
      size: 11 11

