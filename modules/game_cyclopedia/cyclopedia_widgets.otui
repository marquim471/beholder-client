    margin-right: 3
    image-size: 12 12
    image-clip: 0 0 12 12
    image-source: /images/ui/miniwindow/exit-button-small-up
    $hover:
      image-clip: 0 0 12 12
    $pressed:
      image-clip: 0 0 12 12
      image-source: /images/ui/miniwindow/exit-button-small-down

  UIButton
    id: minimizeButton
    size: 12 12
    anchors.top: closeButton.top
    anchors.right: closeButton.left
    margin-right: 1
    image-size: 12 12
    image-clip: 0 0 12 12
    image-source: /images/ui/miniwindow/min-button-small-up
    $hover:
      image-clip: 0 0 12 12
    $pressed:
      image-clip: 0 0 12 12
      image-source: /images/ui/miniwindow/min-button-small-down
    $on:
      image-clip: 0 0 12 12
      image-source: /images/ui/miniwindow/max-button-small-up
    $on hover:
      image-clip: 0 0 12 12
      image-source: /images/ui/miniwindow/max-button-small-up
    $on pressed:
      image-clip: 0 0 12 12
      image-source: /images/ui/miniwindow/max-button-small-down

  UIButton
    id: contextMenuButton
    size: 12 12
    anchors.top: minimizeButton.top
    anchors.right: minimizeButton.left
    margin-right: 5
    image-size: 12 12
    image-clip: 0 0 12 12
    image-source: /images/ui/miniwindow/button-contextmenu-12x12-idle
    $hover:
      image-clip: 0 0 12 12
    $pressed:
      image-clip: 0 0 12 12
      image-source: /images/ui/miniwindow/button-contextmenu-12x12-pressed

  UIButton
    id: newWindowButton
    size: 12 12
    anchors.top: contextMenuButton.top
    anchors.right: contextMenuButton.left
    margin-right: 1
    image-source: /images/ui/test/button-verydarkgrey-up
    image-size: 12 12
    image-clip: 0 0 98 40
    image-border: 1
    image-repeated: true
    icon: /images/ui/miniwindow/icon-additionalwidget
    icon-offset: 0 0
    $hover:
      image-clip: 0 0 98 40
    $pressed:
      image-source: /images/ui/test/button-verydarkgrey-down
      image-clip: 0 0 98 40
      icon-offset: 1 1
    $on:
      image-clip: 0 0 98 40

  UIScrollBar
    id: miniwindowScrollBar
    orientation: vertical
    width: 12
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-top: 15
    margin-right: 4
    margin-bottom: 4
    step: 20
    increment: 20
    pixels-scroll: true
    image-source: /images/ui/modal/scrollbar-texture-vertical
    image-clip: 0 0 12 96
    image-border: 0
    image-repeated: true

    UIButton
      id: decrementButton
      anchors.top: parent.top
      anchors.left: parent.left
      size: 12 12
      image-source: /images/ui/modal/scrollbar-buttonup-up
      $pressed:
        image-source: /images/ui/modal/scrollbar-buttonup-down

    UIButton
      id: incrementButton
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      size: 12 12
      image-source: /images/ui/modal/scrollbar-buttondown-up
      $pressed:
        image-source: /images/ui/modal/scrollbar-buttondown-down

    UIButton
      id: sliderButton
      anchors.centerIn: parent
      size: 12 14
      image-source: /images/ui/modal/scrollbar-handle-vertical
      image-border-top: 6
      image-border-bottom: 6

  MiniWindowContents
    id: contentsPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: miniwindowScrollBar.left
    anchors.bottom: parent.bottom
    margin-left: 4
    margin-top: 15
    margin-right: 1
    margin-bottom: 4
    vertical-scrollbar: miniwindowScrollBar
    padding: 0
    layout: verticalBox

  // RTC bottom-left resize corner.
  RtcMiniBorder
    margin-left: 2
    margin-bottom: 2

bestiaryTrackerMenu < PopupMenu
  id: imbuementTrackerMenu
  width: 304

  ImbuementTrackerMenuOption
    id: sortByName
    !text: tr('sort by name')

  ImbuementTrackerMenuOption
    id: ShortByPercentage
    !text: tr('Short by completion percentage')

  ImbuementTrackerMenuOption
    id: sortByKills
    !text: tr('sort by remaining kills')

  HorizontalSeparator

  ImbuementTrackerMenuOption
    id: sortByAscending
    !text: tr('sort by ascending')

  ImbuementTrackerMenuOption
    id: sortByDescending
    !text: tr('sort by descending')
StoreFlatPanel < UIWidget
  phantom: true
  auto-focus: first
  image-source: /game_store/images/panel
  image-border: 3
Box < UIWidget
  border-width-top: 1
  border-color-top: black
  border-width-left: 1
  border-color-left: black
  border-width-bottom: 1
  border-color-bottom: gray
  border-width-right: 1
  border-color-right: gray
  image-smooth: true
  image-fixed-ratio: false
RowStore2 < UIWidget
  height: 78
  margin: 2
  border: 0 white

  $focus:
    border: 2 white

  Box
    id: image
    size: 64 64
    anchors.top: parent.top
    anchors.left: parent.left
    margin: 5 0 0 5

  Label
    id: lblName
    anchors.top: parent.top
    anchors.left: prev.right
    anchors.right: parent.right
    margin: 8 0 0 8
    text-auto-resize: true
    text-wrap: true
  Label
    id: count
    anchors.bottom: parent.bottom
    anchors.left: image.right
    margin: 0 5 5 0
    margin-left:22
    text-align: center

  StoreFlatPanel
    id: lblPrice
    size: 104 20
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin: 0 5 5 0
    text-align: center
    text-offset: 15 0
    image-color: #1111118c
    icon: /images/ui/tibiaCoin
    icon-align: right
    icon-offset: -2 0

BlessCreate < UIWidget
  background-color: alpha
  text-offset: 35 1
  focusable: true
  font: verdana-11px-rounded
  text-align: left

  Label
    id: text2
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    width: 15
    height: 15
    margin-top: 2
    margin-left: 3

  Label
    id: text1
    margin-left: 8
    anchors.left: prev.right
    anchors.verticalCenter: parent.verticalCenter
    focusable: false
