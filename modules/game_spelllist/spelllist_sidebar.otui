SpellSidebarFrame < UIWidget
  UIWidget
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 1
    image-source: /images/ui/modal/1pixel-down-frame-top
    image-repeated: true
    phantom: true
  UIWidget
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-top: 1
    width: 1
    image-source: /images/ui/modal/1pixel-down-frame-left
    image-repeated: true
    phantom: true
  UIWidget
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-top: 1
    width: 1
    image-source: /images/ui/modal/1pixel-down-frame-right
    image-repeated: true
    phantom: true
  UIWidget
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 1
    margin-right: 1
    height: 1
    image-source: /images/ui/modal/1pixel-down-frame-bottom
    image-repeated: true
    phantom: true


SpellListSidebar < UIMiniWindow
  id: spellListSidebar
  &save: true
  &type: 'spellListSidebar'
  width: 192
  height: 269
  focusable: true
  image-source: /images/ui/widget-borderimage
  image-border: 4
  image-border-top: 15
  image-repeated: true
  &minimizedHeight: 19

  UIWidget
    id: miniwindowHeader
    image-source: none
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 15
    phantom: true

  UIWidget
    id: miniwindowTopBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 15
    phantom: true

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 4
    minimum: 243
    margin-left: 3
    margin-right: 3

  UIWidget
    id: miniwindowIcon
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    margin-top: 2
    margin-left: 4
    size: 12 12
    image-source: /images/icons/icon-spell-list-widget
    image-smooth: false

  Label
    id: miniwindowTitle
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    anchors.right: menuButton.left
    margin-top: 1
    margin-left: 20
    margin-right: 5
    font: Verdana Bold-11px
    height: 13
    color: #909090

    !text: tr('Spell List')

  UIButton
    id: closeButton
    size: 12 12
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 2
    margin-right: 3
    image-size: 12 12
    image-clip: 0 0 12 12
    image-source: /images/ui/miniwindow/exit-button-small-up
    $hover:
      image-clip: 0 0 12 12
    $pressed:
      image-clip: 0 0 12 12
      image-source: /images/ui/miniwindow/exit-button-small-down

  UIButton
    id: minimizeButton
    size: 12 12
    anchors.top: closeButton.top
    anchors.right: closeButton.left
    margin-right: 1
    image-size: 12 12
    image-clip: 0 0 12 12
    image-source: /images/ui/miniwindow/min-button-small-up
    $hover:
      image-clip: 0 0 12 12
    $pressed:
      image-clip: 0 0 12 12
      image-source: /images/ui/miniwindow/min-button-small-down
    $on:
      image-clip: 0 0 12 12
      image-source: /images/ui/miniwindow/max-button-small-up
    $on hover:
      image-clip: 0 0 12 12
      image-source: /images/ui/miniwindow/max-button-small-up
    $on pressed:
      image-clip: 0 0 12 12
      image-source: /images/ui/miniwindow/max-button-small-down

  UIScrollBar
    id: miniwindowScrollBar
    orientation: vertical
    width: 12
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-top: 35
    margin-right: 4
    margin-bottom: 170
    step: 20
    increment: 20
    pixels-scroll: true
    image-source: /images/ui/modal/scrollbar-texture-vertical
    image-clip: 0 0 12 96
    image-border: 0
    image-repeated: true

    UIButton
      id: decrementButton
      anchors.top: parent.top
      anchors.left: parent.left
      size: 12 12
      image-source: /images/ui/modal/scrollbar-buttonup-up
      $pressed:
        image-source: /images/ui/modal/scrollbar-buttonup-down

    UIButton
      id: incrementButton
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      size: 12 12
      image-source: /images/ui/modal/scrollbar-buttondown-up
      $pressed:
        image-source: /images/ui/modal/scrollbar-buttondown-down

    UIButton
      id: sliderButton
      anchors.centerIn: parent
      size: 12 14
      image-source: /images/ui/modal/scrollbar-handle-vertical
      image-border-top: 6
      image-border-bottom: 6

  UIButton
    id: menuButton
    size: 12 12
    anchors.top: minimizeButton.top
    anchors.right: minimizeButton.left
    margin-right: 5
    image-source: /images/ui/miniwindow/button-contextmenu-12x12-idle
    $pressed:
      image-source: /images/ui/miniwindow/button-contextmenu-12x12-pressed

  MiniWindowContents
    id: contentsPanel
    anchors.fill: parent
    margin: 15 4 4 4

    UITextEdit
      id: search
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 20
      background-color: #363636
      color: #c0c0c0
      font: verdana-bold-11px-native
      placeholder-font: verdana-bold-11px-placeholder
      placeholder: Type to search
      placeholder-color: #707070
      padding: 2 20 3 5
      max-length: 255
      selection-background-color: #808080
      cursor: none
      blink-speed: 600

    SpellSidebarFrame
      anchors.fill: search
      phantom: true

    ClassicButton
      id: clearSearch
      anchors.right: search.right
      anchors.top: search.top
      margin: 1 1 0 0
      size: 18 18
      image-clip: 0 0 98 40
      image-repeated: true
      icon-source: /images/ui/icon-erase-small

    UIScrollArea
      id: spells
      anchors.top: search.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: separator.top
      margin-right: 12
      margin-top: 1
      margin-bottom: 1
      layout: verticalBox
      focusable: true

    UIWidget
      id: separator
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: details.top
      margin-bottom: 1
      height: 2
      phantom: true
      UIWidget
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        height: 1
        image-source: /images/automap/horizontal-line-dark
        image-repeated: true
        phantom: true
      UIWidget
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        height: 1
        image-source: /images/automap/horizontal-line-bright
        image-repeated: true
        phantom: true

    Panel
      id: details
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: showMore.top
      margin-left: 2
      margin-bottom: 6
      height: 134

    ClassicButton
      id: showMore
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.bottom: parent.bottom
      margin-bottom: 5
      size: 86 20
      font: verdana-bold-8px-native
      image-clip: 0 0 98 40
      image-repeated: true
      text: Show More

  UIWidget
    id: miniborder
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-left: 3
    margin-bottom: 3
    size: 13 13
    image-source: /images/ui/miniwindow/windowresizer
    phantom: true

  UIWidget
    id: focusFrame
    anchors.fill: parent
    border-width: 2
    border-color: white
    visible: false
    phantom: true
    focusable: false
    $on:
      visible: true
