MainWindow
  id: tasksWindow
  !text: 'Tasks'
  size: 911 600
  @onEnter: |
    if self.main.gridPanel:isVisible() then
      modules.game_ranktasks.reloadPageContent(true, true)
    end

  @onEscape: |
    modules.game_ranktasks.hide()

  UIWidget
    id: main
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: separator.top
    margin-bottom: 10

    UIWidget
      id: gridPanel
      anchors.fill: parent
      visible: false

      UIWidget
        id: tabs
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        height: 40
        image-source: /game_ranktasks/images/tab_button
        image-border: 3
        image-clip: 1 44 20 24
        padding: 1
        layout:
          type: horizontalBox

        TaskTabButton
          !text: 'Aprendiz'
          &gifFrames: 1
          &gifSource: '/game_ranktasks/images/tab_1'

        TaskTabButton
          !text: 'Ca\231ador'
          &gifFrames: 1
          &gifSource: '/game_ranktasks/images/tab_2'

        TaskTabButton
          !text: 'Veterano'
          &gifFrames: 15
          &gifSource: '/game_ranktasks/images/tab_3'

        TaskTabButton
          !text: 'Campe\227o'
          &gifFrames: 15
          &gifSource: '/game_ranktasks/images/tab_4'

        TaskTabButton
          !text: 'Lend\225rio'
          &gifFrames: 15
          &gifSource: '/game_ranktasks/images/tab_5'

        TaskTabButton
          !text: 'Especial'
          &gifFrames: 15
          &gifSource: '/game_ranktasks/images/tab_special'

      UIWidget
        id: filters
        image-source: /images/ui/2pixel_up_frame_borderimage
        image-border-left: 2
        image-border-right: 2
        image-border-top: 27
        image-border-bottom: 4
        phantom: true
        padding-top: 22
        padding-left: 7
        padding-right: 7
        padding-bottom: 7
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: tabs.bottom
        margin-top: 5
        height: 100

        Label
          id: title
          !text: 'Filtros'
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 2
          phantom: true
          margin-top: -20
          text-horizontal-auto-resize: true
          color: #909090

        UIWidget
          id: flags
          anchors.left: parent.left
          anchors.top: parent.top
          anchors.bottom: starsBackground.bottom
          margin-top: 5
          image-source: /images/ui/1pixel_down_frame
          image-border: 2
          width: 335

          QtCheckBox
            id: showCompleted
            anchors.left: parent.left
            anchors.top: parent.top
            text-offset: 18 -2
            !text: 'Mostrar finalizados'
            &defaultValue: true
            color: #C0C0C0FF
            margin-top: 7
            margin-left: 5
            width: 160
            checked: true
            @onCheckChange: |
              modules.game_ranktasks.reloadPageContent(false, true)

          QtCheckBox
            id: showLocked
            anchors.left: parent.left
            anchors.top: prev.bottom
            text-offset: 18 -2
            !text: 'Mostrar bloqueados'
            &defaultValue: true
            color: #C0C0C0FF
            margin-top: 5
            margin-left: 5
            width: 150
            checked: true
            @onCheckChange: |
              modules.game_ranktasks.reloadPageContent(false, true)

          QtCheckBox
            id: showActives
            anchors.left: parent.left
            anchors.top: prev.bottom
            text-offset: 18 -2
            !text: 'Mostrar ativos'
            &defaultValue: true
            color: #C0C0C0FF
            margin-top: 5
            margin-left: 5
            width: 160
            checked: true
            @onCheckChange: |
              modules.game_ranktasks.reloadPageContent(false, true)

          QtCheckBox
            id: showAvailables
            anchors.left: parent.left
            anchors.top: parent.top
            text-offset: 18 -2
            !text: 'Mostrar disponiveis'
            &defaultValue: true
            color: #C0C0C0FF
            margin-top: 7
            margin-left: 175
            width: 150
            checked: true
            @onCheckChange: |
              modules.game_ranktasks.reloadPageContent(false, true)

          // Show Tracker: the square with the tracked creature in the corner of the game map.
          QtCheckBox
            id: showTracker
            anchors.left: parent.left
            anchors.top: showAvailables.bottom
            text-offset: 18 -2
            !text: 'Show Tracker'
            color: #C0C0C0FF
            margin-top: 5
            margin-left: 175
            width: 150
            checked: false
            @onCheckChange: |
              if modules.game_ranktaskstracker and modules.game_ranktaskstracker.setMapTrackerVisible then
                modules.game_ranktaskstracker.setMapTrackerVisible(self:isChecked())
              end

        UIWidget
          id: starsBackground
          image-source: /images/ui/1pixel_down_frame
          image-border: 2
          anchors.right: parent.right
          anchors.top: parent.top
          margin-top: 1
          size: 295 70

          UIWidget
            id: starsTitle
            !text: 'Dificuldades:'
            color: #C0C0C0
