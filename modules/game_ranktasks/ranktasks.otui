TaskTabButton < ButtonBox
  image-source: /game_ranktasks/images/tab_button
  image-clip: 1 0 20 23
  image-border: 3
  text-offset: 7 0
  color: #C0C0C0
  change-cursor-image: false
  padding-top: 0
  padding-left: 5
  size: 42 34
  text-offset: 42 0
  text-align: left
  @onCheckChange: |
    if self.ignoreCallback then
      return
    end
    if not(self:isChecked()) then
      self.ignoreCallback = true
      self:setChecked(true)
      self.ignoreCallback = nil
      return
    end
    for _, c in ipairs(self:getParent():getChildren()) do
      if c:isChecked() and c ~= self then
        c.ignoreCallback = true
        c:setChecked(false)
        c.ignoreCallback = nil
      end
    end
    modules.game_ranktasks.reloadPageContent(false, true)

  @onSetup: |
    self:getChildById('icon'):setImageSource(self.gifSource)

  $hover !disabled:
    image-clip: 1 0 20 23

  // Only the selected tab shows its name (the others are just the icon, 42 px wide).
  $!checked:
    color: #00000000

  $checked:
    image-clip: 0 46 22 23
    color: #C0C0C0
    text-offset: 43 2
    change-cursor-image: false
    padding-top: 1
    padding-left: 6
    size: 130 34

  UIWidget
    id: icon
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: parent.left
    size: 32 32
    phantom: true

