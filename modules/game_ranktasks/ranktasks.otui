  HorizontalSeparator
    id: separator
    anchors.left: parent.left
    anchors.bottom: close.top
    anchors.right: parent.right
    margin-bottom: 10

  Button
    id: close
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    font: cipsoftFont
    color: white
    width: 65
    margin-top: 10
    !text: 'Close'
    @onClick: |
      modules.game_ranktasks.hide()

  Button
    id: back
    anchors.right: close.left
    anchors.bottom: parent.bottom
    font: cipsoftFont
    color: white
    width: 65
    margin-right: 5
    !text: 'Back'
    visible: false
    @onClick: |
      modules.game_ranktasks.backToGrid()

