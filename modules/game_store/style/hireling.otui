StoreConfigurationWindow
  id: changeNameWindow
  size: 350 200
  !text: tr('Customise Hireling')

  Panel
    id: infoLabel
    anchors.top: parent.top
    anchors.left: parent.left
    size: 320 64
    Label
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 64
      margin-top: 5
      margin-left: 5
      !text: tr('Here you can customise your hireling for BEHOLDER. Enter a name and choose its sex before confirming your purchase.')
      text-wrap: true
  Label
    !text: tr('Name:')
    anchors.top: infoLabel.bottom
    anchors.left: parent.left
    margin-top: 10
    margin-left: 5
  TextEdit
    id: transferPointsText
    max-length: 29
    anchors.left: prev.right
    anchors.top: infoLabel.bottom
    margin-top: 5
    margin-left: 10
    width: 275
  Label
    id: sexLabel
    !text: tr('Sex:')
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 10
    margin-left: 5
  ComboBox
    id: sex
    anchors.left: prev.right
    anchors.top: transferPointsText.bottom
    margin-top: 5
    margin-left: 20
    size: 275 20
      self:addOption("Male")
      self:addOption("Female")
  HorizontalSeparator
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 8

  Button
    id: closeButton
    font: cipsoftFont
    size: 40 20
    !text: tr('Cancel')
    anchors.right: parent.right
    anchors.top: separator.bottom
    margin-top: 5

  Button
    id: buttonOk
    font: cipsoftFont
    size: 40 20
    !text: tr('Buy Now')
    anchors.right: prev.left
    anchors.top: separator.bottom
    margin-top: 5
    margin-right: 5
    enabled: false

