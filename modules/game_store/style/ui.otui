OfferPanel2 < Panel
  height: 44

  UIButton
    id: btnBuy
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 20
    font: cipsoftFont
    color: #dfdfdf
    text-offset: 0 2
    text: Buy
    image-source: /game_store/images/buybutton
    image-clip: 0 0 144 20
    $pressed:
      image-clip: 0 20 144 20
      text-offset: 1 1
    $disabled:
      image-clip: 0 40 144 20
      color: #dfdfdf88

  StoreBalance
    id: lblPrice
    anchors.top: btnBuy.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    text-offset: -64 0
    icon-offset: -49 0

stackOfferPanel < Panel
  height: 20

  StoreLabel
    id: count
    anchors.left: parent.left
    anchors.right: lblPrice.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 5
    height: 15
    text-align: right

  StoreBalance
    id: lblPrice
    width: 100
    anchors.top: parent.top
    anchors.right: parent.right

StoreFlatPanel < UIWidget
  phantom: true
  auto-focus: first
  image-source: /game_store/images/panel
  image-border: 3

StoreLightFlatPanel < UIWidget
  phantom: true
  auto-focus: first
  image-source:  /game_store/images/panel_container
  image-border: 3

StoreButton < ClassicButton
  size: 43 20

StoreWindow < UIWindow
  anchors.centerIn: parent
  font: verdana-11px-antialised
  color: #8f8f8f
  text-offset: 0 2
  text-align: top
  image-source: /images/ui/popupwindow
  image-border: 6
  image-border-top: 27
  padding: 28 17 16 16

StoreFlatLabel < UILabel
  font: Verdana Bold-11px
  color: #dfdfdf
  size: 86 20
  text-offset: 3 3
  image-source:  /game_store/images/panel_flat
  image-border: 1
  clipping: true

  $disabled:
    color: #dfdfdf88

StoreLabel < UILabel
  font: Verdana Bold-11px
  color: #c0c0c0
  phantom: true

StoreFrame < Panel
  image-source: /images/ui/2pixel-up-frame-borderimage
