StoreInset < Panel
  image-source: /images/ui/1pixel-down-frame
  image-border: 1

StoreBalance < UIWidget
  font: Verdana Bold-11px
  color: #c0c0c0
  image-source: /images/ui/backdrop-dark-grey
  image-repeated: true
  height: 20
  text-align: right
  text-offset: -18 0
  icon: /game_store/images/icon-tibiacoin
  icon-align: right
  icon-offset: -3 0
  phantom: true

  StoreInset
    anchors.fill: parent

  StoreLabel
    id: basePrice
    font: Verdana-Strikethrough-11px
    color: #707070
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: parent.right
    text-auto-resize: true
    visible: false

storeCategory < UIWidget
  size: 170 20

  UIButton
    id: Button
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: -5
    margin-left: 2
    height: 24
    image-source: /game_store/images/categorie-up
    image-clip: 0 0 170 24
    image-border: 1
    focusable: false

    $pressed:
      image-source: /game_store/images/categorie-down

    $disabled:
      opacity: 0.8

    UIWidget
      id: Icon
      size: 13 13
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 7
      margin-top: 4
      phantom: true
      image-smooth: false

    StoreLabel
      id: Title
      anchors.left: Icon.right
      anchors.right: Arrow.left
      anchors.top: parent.top
      margin-left: 5
      margin-right: 4
      margin-top: 4
      height: 14
      text-align: left

    UIWidget
      id: Arrow
      size: 7 7
      anchors.right: parent.right
      anchors.top: parent.top
      margin-right: 12
      margin-top: 8
      phantom: true
      image-source: /images/ui/icon-arrow7x7-down
      visible: false

  Panel
    id: subPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 17
    margin-left: 3
    margin-right: 2
    image-source: /game_store/images/arrow-panel
    image-border: 1
    visible: false

  UIWidget
    id: SelectionArrow
    size: 4 7
    anchors.left: parent.left
    anchors.top: subPanel.top
    margin-left: 7
    phantom: true
    image-source: /game_store/images/arrow
    visible: false

storeSubCategory < UIWidget
  size: 153 20

  UIButton
    id: Button
    anchors.fill: parent
    image-source: /game_store/images/subcategory
    image-clip: 0 0 152 20
    image-border: 1
    focusable: false

    $pressed:
      image-clip: 0 20 152 20

    $checked:
      image-clip: 0 20 152 20

    $disabled:
      opacity: 0.8

    UIWidget
      id: Icon
      size: 13 13
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8
      margin-top: 0
      phantom: true
      image-smooth: false

    StoreLabel
      id: Title
      anchors.left: Icon.right
      anchors.right: parent.right
      anchors.top: parent.top
      margin-left: 5
      margin-right: 3
      margin-top: 4
      height: 14
      text-align: left


confirmarSHOP < StoreWindow
  id: storePurchaseSuccess
  size: 350 153
  text: Purchase completed successfully
  font: Verdana Bold-11px
  text-offset: -2 1
  image-source: /images/ui/popupwindow
  padding: 17 4 4 4

  UIWidget
    id: dragon
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: -85
    size: 192 70
    phantom: true
    image-source: /game_store/images/dragon-animated

  StoreLabel
    id: Box
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 12
    margin-left: 12
    size: 200 108
    padding: 4
    text-wrap: true
    text-align: topLeft
    image-source: /images/ui/textedit
    image-border: 1

  Button
    id: buttonAnimation
    size: 108 108
    anchors.top: Box.top
    anchors.left: Box.right
    margin-left: 10
    image-source: /game_store/images/button-blue-big
    image-clip: 0 0 108 108
    $pressed:
      image-clip: 0 108 108 108

    UIWidget
      id: animation
      image-source: /game_store/images/purchasecomplete_idle
      anchors.fill: parent
      phantom: true

BorderBox < UIWidget
  border-width-top: 1
  border-color-top: black
  border-width-left: 1
  border-color-left: black
  border-width-bottom: 1
  border-color-bottom: #747474
  border-width-right: 1
