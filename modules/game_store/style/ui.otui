StoreConfigurationWindow < StoreWindow
  font: verdana-11px-antialised
  color: #8f8f8f
  text-offset: 0 2
  image-source: /images/ui/popupwindow
  image-border: 6
  image-border-top: 27
  padding: 35 16 10 16

StorePurchaseWindow < StoreWindow
  id: storePurchaseWindow
  size: 380 235
  text: Confirmation of Purchase
  font: Verdana Bold-11px
  text-offset: -2 1
  image-source: /images/ui/popupwindow
  padding: 17 4 4 4

  StoreLabel
    id: content
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 11
    margin-left: 11
    margin-right: 12
    text-wrap: true
    text-auto-resize: true

  StoreInset
    id: Box
    anchors.top: content.bottom
    anchors.left: parent.left
    margin-top: 8
    margin-left: 12
    size: 80 80
    image-source: /game_store/images/scrollarea

  StoreInset
    id: detailsPanel
    anchors.top: Box.top
    anchors.left: Box.right
    anchors.right: parent.right
    margin-left: 10
    margin-right: 13
    height: 80
    image-source: /game_store/images/scrollarea

  StoreLabel
    id: details
    anchors.top: detailsPanel.top
    anchors.left: detailsPanel.left
    anchors.right: detailsPanel.right
    margin-top: 23
    margin-left: 10
    margin-right: 13
    text-wrap: true
    text-auto-resize: true

  StoreLabel
    id: price
    anchors.top: details.bottom
    anchors.left: details.left
    margin-top: 4
    text-auto-resize: true

  UIWidget
    id: coin
    anchors.top: price.top
    anchors.left: price.right
    margin-top: 2
    margin-left: 5

  Button
    id: cancel
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 12
    margin-right: 12
    size: 43 20
    text: Cancel

  Button
    id: buy
    anchors.bottom: cancel.bottom
    anchors.right: cancel.left
    margin-right: 5
    size: 43 20
    image-source: /game_store/images/small-buybutton
    image-clip: 0 0 43 20
    $hover:
      image-clip: 0 0 43 20
    $pressed:
      image-clip: 0 20 43 20

  HorizontalSeparator
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: buy.top
    margin-bottom: 10
    margin-left: 12
    margin-right: 12

StoreScrollBarBase < UIButton
  id: sliderButton
  anchors.centerIn: parent
  image-source: /game_store/images/scrollbar
  image-border: 6
  opacity: 1

  $disabled:
    opacity: 0

StoreScrollBarValueLabel < Label
  id: valueLabel
  anchors.fill: parent
  color: white
  text-align: center

StoreScrollBarSlider < StoreScrollBarBase
  size: 12 12
  minimum: 12
  image-clip: 0 24 12 14

StoreScrollBar < UIScrollBar
  orientation: vertical
  width: 12
  height: 39
  image-source: /game_store/images/scrollbar
  image-clip: 24 0 12 74
  image-border: 1
  pixels-scroll: true

  UIButton
    id: decrementButton
    anchors.top: parent.top
    anchors.left: parent.left
    image-source: /game_store/images/scrollbar
    size: 12 12
    image-clip: 0 0 12 12
    $pressed:
      image-clip: 12 0 12 12

  UIButton
    id: incrementButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    size: 12 12
    image-source: /game_store/images/scrollbar
    image-clip: 0 12 12 12
    $pressed:
      image-clip: 12 12 12 12

  StoreScrollBarSlider

  StoreScrollBarValueLabel

StoreComboBoxPopupScrollMenuButton < UIButton
  height: 17
  font: Verdana Bold-11px
  text-align: left
  text-offset: 4 0
  color: #c0c0c0
  background-color: alpha
  margin: 1

  $hover !disabled:
    color: #f4f4f4
    background-color: #86868750

  $disabled:
    color: #dfdfdf88

StoreComboBoxPopupScrollMenu < UIPopupScrollMenu
  image-source: /game_store/images/combobox-square
  image-clip: 0 60 98 20
  image-border: 1

StoreComboBoxPopupMenuButton < UIButton
  height: 17
  font: Verdana Bold-11px
  text-align: left
  text-offset: 4 0
  color: #c0c0c0
  background-color: alpha
  margin: 1

  $hover !disabled:
    color: #f4f4f4
    background-color: #86868750

  $disabled:
    color: #dfdfdf88

StoreComboBoxPopupMenu < UIPopupMenu
  image-source: /game_store/images/combobox-square
  image-clip: 0 60 98 20
  image-border: 1

StoreComboBox < UIComboBox
  font: Verdana Bold-11px
  color: #c0c0c0
  text-offset: -15 2
  size: 91 20
  image-source: /game_store/images/combobox-square
  image-border: 3
  image-border-right: 21
  image-clip: 0 0 91 20

  $hover !disabled:
    image-clip: 0 0 91 20

  $on:
    image-clip: 0 40 91 20

  $disabled:
    color: #dfdfdf88
    opacity: 0.8

  $checked:
    image-clip: 0 20 91 20
