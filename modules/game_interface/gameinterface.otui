ActionBarLockButton < UIButton
  image-source: /images/ui/button-grey-up
  image-repeated: true
  image-border: 1
  icon-source: /images/game/actionbar/unlocked
  icon-offset: 0 0
  tooltip: Action Bars Unlocked: You can assign actions to or switch actions on action buttons by "drag&drop".

  $checked:
    icon-source: /images/game/actionbar/locked
    tooltip: Action Bars Locked: You cannot assign actions to or switch actions on action buttons by "drag&drop".

  $pressed:
    image-source: /images/ui/button-grey-down
    icon-offset: 1 1
    icon-source: /images/game/actionbar/locked

  $pressed checked:
    icon-source: /images/game/actionbar/unlocked

GameSidePanel < UIMiniWindowContainer
  image-source: /images/ui/2pixel_up_frame_borderimage
  image-border: 4
  width: 176
  layout:
    type: verticalBox
    //spacing: 1

SelectColumnButton < CheckBox
  visible: false
  opacity: 0.3
  $hover:
    opacity: 1

GameBottomPanel < UIWindow
  image-source: /images/ui/background_dark
  image-repeated: true
  draggable:false

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    enabled: false
    height: 5
    margin-top: 5
    minimum: 170

  ResizeBorder
    id: rightResizeBorder
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    enabled: false
    minimum: 300


GameMapPanel < UIGameMap
  map-border-image-source: /images/game/interface/map-frame
  padding: 4
  image-source: /images/game/interface/background
  image-repeated: true

  $on:
    padding: 0

UIWidget
  id: gameRootPanel
  anchors.fill: parent
  anchors.top: topMenu.bottom

  GameMapPanel
    id: gameMapPanel
    anchors.left: gameLeftActionPanel.right
    anchors.right: gameRightActionPanel.left
    anchors.top: gameTopPanel.bottom
    anchors.bottom: bottomSplitter.top
    focusable: false
    margin-top: 1
    margin-bottom: 1

    Button
      id: showTopMenuButton
      anchors.top: parent.top
      anchors.left: parent.left
      !text: tr('Show Top Menu')
      height: 32
      visible: false

  UIWidget
    id: gameLowerPanelBackground
    anchors.left: bottomSplitter.left
    anchors.right: bottomSplitter.right
    anchors.top: bottomSplitter.bottom
    anchors.bottom: parent.bottom
    margin-top: 1
    image-source: /images/game/interface/background-dark
    image-repeated: true
    phantom: true

// actionbar
  Panel
    id: gameLeftActionPanel
    phantom: true
    focusable: false
    anchors.top: gameTopPanel.bottom
    anchors.left: gameLeftExtraPanel.right
    anchors.bottom: bottomSplitter.top
    padding-top: 1
    margin-left: 1
    border-width-right: 1
    border-color-right: #292929
    width: 36
    image-source: /images/ui/actionbar/actionbar_background-light
    image-border: 1
    margin-bottom: 16
    padding-right: 3 
    layout:
      type: horizontalBox
      fit-children: true
      spacing: 2
  UIWidget
    id: lockLeftPanel
    size: 38 16
    anchors.top: gameLeftActionPanel.bottom
    margin-top: 1
    anchors.left: gameLeftActionPanel.left
    border-width-right: 1
    border-color-right: #292929
    image-source: /images/ui/actionbar/actionbar_background-light
    ActionBarLockButton
      id: leftLock
      size: 34 16
      anchors.top: parent.top
      anchors.right: parent.right
      margin-right: 1
      @onClick: modules.game_actionbar.changeLockStatus(self, "Left")
      $pressed:
        icon-offset: 1 1

  Panel
    id: gameRightActionPanel
    phantom: true
    focusable: false
    anchors.top: gameTopPanel.bottom
    anchors.right: gameRightExtraPanel.left
    anchors.bottom: bottomSplitter.top
    margin-right: 1
    margin-top: 1
    border-width-left: 1
    border-color-left: #747474
    width: 36
    image-source: /images/ui/actionbar/actionbar_background-light
    image-border: 1
    margin-bottom: 16
    padding-left: 3

    layout:
      type: horizontalBox
      fit-children: true
      spacing: 2
  UIWidget
    id: lockRightPanel
    size: 38 16
    anchors.top: gameRightActionPanel.bottom
    margin-top: 1
    anchors.right: gameRightActionPanel.right
    border-width-left: 1
    border-color-left: #747474
    image-source: /images/ui/actionbar/actionbar_background-light

    ActionBarLockButton
      id: rightLock
      size: 34 16
      anchors.top: parent.top
      anchors.right: parent.right
      margin-right: 1
      @onClick: modules.game_actionbar.changeLockStatus(self, "Right")
      $pressed:
        icon-offset: 1 1
  Panel
    id: gameBottomActionPanel
    phantom: true
    focusable: false
    margin-right: 12
    padding-bottom: 2
    anchors.left: bottomSplitter.left
    anchors.right: bottomSplitter.right
    anchors.top: bottomSplitter.bottom
    margin-top: 3
    layout:
      type: verticalBox
      fit-children: true

  UIWidget
    id: lockPanel
    size: 12 79
    anchors.top: gameBottomActionPanel.top
    anchors.bottom: gameBottomActionPanel.bottom
    anchors.left: gameBottomActionPanel.right
    margin-left: 1
    border-width-top: 1
    border-color-top: #292929
    image-source: /images/ui/actionbar/background-dark

    ActionBarLockButton
      id: bottomLock
      width: 12
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 1
      margin-bottom: 1
      icon-offset: 0 0
      @onClick: modules.game_actionbar.changeLockStatus(self, "Bottom")
      $pressed:
        icon-offset: 1 1

  Panel
    id: gameBottomCooldownPanel
    phantom: true
    focusable: false
    anchors.left: bottomSplitter.left
    anchors.right: bottomSplitter.right
    anchors.top: gameBottomStatsBarPanel.bottom
    margin-top: 1
    layout:
      type: verticalBox
      fit-children: true
// end actionsbar
  GameBottomPanel
    id: gameBottomPanel
    anchors.left: gameBottomCooldownPanel.left
    anchors.right: gameBottomCooldownPanel.right
    anchors.top: gameBottomCooldownPanel.bottom
    margin-top: 3
    anchors.bottom: parent.bottom

  GameSidePanel
    id: gameLeftTopPanel
    anchors.left: parent.left
    anchors.top: parent.top
    width: 0
    height: 200
    focusable: false
    visible: true
    on: true
    $!on:
      height: 0
      visible: false

  GameSidePanel
    id: gameLeftPanel
    anchors.left: parent.left
    anchors.top: gameLeftTopPanel.bottom
    anchors.bottom: parent.bottom
    focusable: false
    visible: true
    on: true
    $!on:
      width: 0
      visible: false

  GameSidePanel
    id: gameLeftExtraPanel
    anchors.left: prev.right
    anchors.top: gameLeftTopPanel.bottom
    anchors.bottom: parent.bottom
    margin-left: 1
    focusable: false
    visible: true
    on: true
    $!on:
      width: 0
      visible: false

  GameSidePanel
    id: gameLeftExtraPanel2
    anchors.left: prev.right
    anchors.top: gameLeftTopPanel.bottom
    anchors.bottom: parent.bottom
    margin-left: 1
    focusable: false
    visible: true
    on: true
    $!on:
      width: 0
      visible: false

  GameSidePanel
    id: gameLeftExtraPanel3
    anchors.left: prev.right
    anchors.top: gameLeftTopPanel.bottom
    anchors.bottom: parent.bottom
    margin-left: 1
    focusable: false
    visible: true
    on: true
    $!on:
      width: 0
      visible: false

  GameSidePanel
    id: gameRightTopPanel
    anchors.right: parent.right
    anchors.top: parent.top
    width: 176
    height: 200
    focusable: false
    visible: true
    on: true
    $!on:
      height: 0
      visible: false

  GameSidePanel
    id: gameMainRightPanel
    anchors.right: parent.right
    anchors.top: gameRightTopPanel.bottom
    width: 176
    &ignoreFillAll: true
    &onlyPhantomDrop: true
    height: 200
    padding-bottom: 0
    focusable: false
    on: true

    UIWidget
      id: mainRightTopDivider
      size: 300 6
      height: 6
      image-source: /images/ui/actionbar/splitterActBottom
      opacity: 100
      margin-right: 1

  UIWidget
    id: rightTopDivider
    anchors.left: gameMainRightPanel.left
    anchors.right: gameMainRightPanel.right
    anchors.top: gameMainRightPanel.top
    size: 300 6
    height: 6
    image-source: /images/ui/actionbar/splitterActBottom
    opacity: 100
    margin-right: 1

  GameSidePanel
    id: gameRightPanel
    anchors.right: parent.right
    anchors.top: gameMainRightPanel.bottom
    margin-top: 1
    anchors.bottom: parent.bottom
    focusable: false
    on: true

  GameSidePanel
    id: gameRightExtraPanel
    anchors.right: gameRightPanel.left
    anchors.top: gameRightTopPanel.bottom
    anchors.bottom: parent.bottom
    margin-right: 1
    focusable: false
    visible: true
    on: true
    $!on:
      width: 0
      visible: false

  GameSidePanel
    id: gameRightExtraPanel2
    anchors.right: prev.left
    anchors.top: gameRightTopPanel.bottom
    anchors.bottom: parent.bottom
    margin-right: 1
    focusable: false
    visible: true
    on: true
    $!on:
      width: 0
      visible: false

  GameSidePanel
    id: gameRightExtraPanel3
    anchors.right: prev.left
    anchors.top: gameRightTopPanel.bottom
    anchors.bottom: parent.bottom
    margin-right: 1
    focusable: false
    visible: true
    on: true
    $!on:
      width: 0
      visible: false

  SelectColumnButton
    id: gameSelectLeftColumn
    anchors.right: gameLeftPanel.right
    anchors.bottom: gameLeftPanel.bottom

  SelectColumnButton
    id: gameSelectRightColumn
    anchors.right: gameRightPanel.right
    anchors.bottom: gameRightPanel.bottom

  SelectColumnButton
    id: gameSelectRightExtraColumn
    anchors.right: gameRightExtraPanel.right
    anchors.bottom: gameRightExtraPanel.bottom

  SelectColumnButton
    id: gameSelectRightExtra2Column
    anchors.right: gameRightExtraPanel2.right
    anchors.bottom: gameRightExtraPanel2.bottom

  SelectColumnButton
    id: gameSelectRightExtra3Column
    anchors.right: gameRightExtraPanel3.right
    anchors.bottom: gameRightExtraPanel3.bottom
    
  SelectColumnButton
    id: gameSelectLeftExtraColumn
    anchors.right: gameLeftExtraPanel.right
    anchors.bottom: gameLeftExtraPanel.bottom

  SelectColumnButton
    id: gameSelectLeftExtra2Column
    anchors.right: gameLeftExtraPanel2.right
    anchors.bottom: gameLeftExtraPanel2.bottom

  SelectColumnButton
    id: gameSelectLeftExtra3Column
    anchors.right: gameLeftExtraPanel3.right
    anchors.bottom: gameLeftExtraPanel3.bottom

  Splitter
    id: bottomSplitter
    anchors.left: gameLeftExtraPanel.right
    anchors.right: gameRightExtraPanel.left
    anchors.bottom: parent.bottom
    height: 7
    image-source: none
    background-color: alpha
    size: 300 7
    opacity: 100
    margin-right: 1
    relative-margin: bottom
    margin-left: 1
    margin-bottom: 200
    @canUpdateMargin: |
      function(self, newMargin)
        return modules.game_interface.constrainBottomPanelHeight(newMargin)
      end

    UIWidget
      id: texture
      anchors.fill: parent
      clipping: true
      phantom: true
      layout:
        type: horizontalBox
        spacing: 0

  UIWidget
    id: mapResizeOverlay
    phantom: true
    size: 60 60
    visible: false
    focusable: false

    UIWidget
      id: scaleFrame
      anchors.left: parent.left
      anchors.top: parent.top
      size: 60 22
      image-source: /images/game/interface/1pixel-up-frame
      image-border: 1
      image-border-bottom: 0

      UIWidget
        anchors.fill: parent
        margin-left: 1
        margin-right: 1
        margin-top: 1
        margin-bottom: -1
        image-source: /images/game/interface/background
        image-repeated: true
        phantom: true

      Label
        id: scale
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 4
        font: verdana-bold-11px-native
        color: #c0c0c0
        text-auto-resize: true
        phantom: true

    UIWidget
      id: modeFrame
      anchors.horizontalCenter: parent.horizontalCenter
      margin-left: 1
      anchors.top: parent.top
      margin-top: 28
      size: 31 32
      image-source: /images/game/interface/1pixel-up-frame
      image-border: 1

      UIWidget
        anchors.fill: parent
        margin-left: 1
        margin-right: 1
        margin-top: -1
        margin-bottom: 1
        image-source: /images/game/interface/background
        image-repeated: true
        phantom: true

      ClassicButton
        id: modeButton
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.top: parent.top
        margin-top: 5
        size: 23 23
        icon: /images/game/interface/icon-resize-mapwindow
        icon-offset: 0 0
        $pressed:
          icon-offset: 1 1

  UIWidget
    id: mouseGrabber
    focusable: false
    visible: false

  TopStatsBar
    id: gameTopPanel
    anchors.left: gameLeftExtraPanel.right
    anchors.right: gameRightExtraPanel.left
    anchors.top: parent.top
    focusable: false

  TopStatsBar
    id: gameBottomStatsBarPanel
    anchors.left: gameLeftExtraPanel.right
    anchors.right: gameRightExtraPanel.left
    anchors.top: gameBottomActionPanel.bottom
    margin-top: 1
    margin-left: 1
    margin-right: 1
    focusable: false

  UIButton
    id: leftIncreaseSidePanels
    anchors.left: gameLeftExtraPanel.right
    anchors.top: parent.top
    image-source: /images/game/interface/button-sidebar-left-add-up
    size: 9 27
    focusable: false
    @onClick: onIncreaseLeftPanels()

    $pressed:
      image-source: /images/game/interface/button-sidebar-left-add-down

    $disabled:
      image-source: /images/game/interface/button-sidebar-left-add-disabled

  UIButton
    id: leftDecreaseSidePanels
    anchors.left: leftIncreaseSidePanels.left
    anchors.top: leftIncreaseSidePanels.bottom
    margin-top: 1
    image-source: /images/game/interface/button-sidebar-left-remove-up
    size: 9 27
    focusable: false
    @onClick: onDecreaseLeftPanels()

    $pressed:
      image-source: /images/game/interface/button-sidebar-left-remove-down

    $disabled:
      image-source: /images/game/interface/button-sidebar-left-remove-disabled

  UIButton
    id: rightIncreaseSidePanels
    margin-right: -1
    anchors.right: gameRightExtraPanel.left
    anchors.top: parent.top
    image-source: /images/game/interface/button-sidebar-right-add-up
    size: 9 27
    focusable: false
    @onClick: onIncreaseRightPanels()

    $pressed:
      image-source: /images/game/interface/button-sidebar-right-add-down

    $disabled:
      image-source: /images/game/interface/button-sidebar-right-add-disabled

  UIButton
    id: rightDecreaseSidePanels
    anchors.right: rightIncreaseSidePanels.right
    anchors.top: rightIncreaseSidePanels.bottom
    margin-top: 1
    image-source: /images/game/interface/button-sidebar-right-remove-up
    size: 9 27
    focusable: false
    @onClick: onDecreaseRightPanels()

    $pressed:
      image-source: /images/game/interface/button-sidebar-right-remove-down

    $disabled:
      image-source: /images/game/interface/button-sidebar-right-remove-disabled

  // Drag handles under the two horizontal top panels; gameinterface.lua resizes the panel above.
  ResizeBorder
    id: leftTopPanelResizeBorder
    anchors.left: gameLeftTopPanel.left
    anchors.right: gameLeftTopPanel.right
    anchors.top: gameLeftTopPanel.bottom
    margin-top: -3
    height: 5

  ResizeBorder
    id: rightTopPanelResizeBorder
    anchors.left: gameRightTopPanel.left
    anchors.right: gameRightTopPanel.right
    anchors.top: gameRightTopPanel.bottom
    margin-top: -3
    height: 5
