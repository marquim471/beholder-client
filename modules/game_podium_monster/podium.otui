PodiumCreatureBox < UIWidget
  size: 108 100
  border-width: 1
  border-color-bottom: #292a29
  border-color-right: #292a29
  border-color-left: #777777
  border-color-top: #777777

  UICheckBox
    id: checkBox
    size: 108 100
    border-width: 1
    border-color: #ffffff
    @onClick: modules.game_podium_monster.selectCreature(self:getParent())
    $checked on:
      border-color: #ffffff
    $!checked:
      border-color: alpha

    UICreature
      id: creature
      size: 64 64
      margin-top: -13
      anchors.centerIn: parent
      phantom: true

    Label
      id: name
      size: 101 30
      color: #c0c0c0
      font: Verdana Bold-11px
      anchors.centerIn: parent
      text-align: center
      text-wrap: true
      margin-top: 38
      phantom: true

PodiumPanel < WindowCyclopedia
  font: Verdana Bold-11px
  color: #909090
  text-offset: -2 1
  text-align: top
  anchors.top: parent.top
  anchors.left: parent.left
  margin-top: 29
  image-source: images/bestiary-slot
  image-border-top: 18
  image-border-bottom: 2
  image-border-left: 2
  image-border-right: 2
  padding-top: 18
  padding-bottom: 2
  padding-left: 2
  padding-right: 2
  draggable: false
  focusable: false
  phantom: true

PodiumCheckPanel < FlatPanel
  size: 122 23
  image-source: images/panel-background
  padding: 1 1 1 1

PodiumCheckBox < CheckBox
  font: Verdana Bold-11px
  text-offset: 14 -3
  text-auto-resize: true
  color: #c0c0c0
  anchors.left: parent.left
  anchors.verticalCenter: parent.verticalCenter
  margin-left: 4

PodiumRotateButton < UIButton
  size: 20 20
  anchors.bottom: parent.bottom
  margin-bottom: 1
  image-source: images/rotate_button
  padding: 1

WindowPodium
  id: podiumWindow
  !text: tr('Customise Podium')
  anchors.horizontalCenter: parent.horizontalCenter
  anchors.verticalCenter: parent.verticalCenter
  size: 754 323
  focusable: true
  @onEscape: modules.game_podium_monster.hide()

  PodiumPanel
    id: configure
    size: 135 246
    !text: tr('Configure')
    margin-left: 16

    PodiumCheckPanel
      id: creaturePanel
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 4
      margin-left: 3

      PodiumCheckBox
        id: creatureShow
        !text: tr('Show Creature')
        @onCheckChange: modules.game_podium_monster.showCreature(self:isChecked())

    PodiumCheckPanel
      id: podiumPanel
      anchors.top: prev.bottom
      anchors.left: prev.left
      margin-top: 5

      PodiumCheckBox
        id: podiumShow
        !text: tr('Show Podium')
        @onCheckChange: modules.game_podium_monster.showPodium(self:isChecked())

  PodiumPanel
    id: preview
    size: 332 246
    !text: tr('Preview')
    margin-left: 156

    FlatPanel
      id: previewGround
      size: 320 192
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 3
      margin-left: 3
      image-source: images/outfit_ground
      padding: 1 1 1 1

      // Official preview: tiles at scale 2; the podium sits on a floor tile, its creature centred.
      UIItem
        id: item
        size: 64 64
        virtual: true
        phantom: true
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 95
        margin-left: 159

      // Creature drawn at the same scale over the podium tile; the item frame would clip it.
      UICreature
        id: creature
        size: 128 128
        phantom: true
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 31
        margin-left: 95

      PodiumRotateButton
        id: rotateLeft
        anchors.left: parent.left
        margin-left: 1
        image-clip: 0 0 20 20
        @onClick: modules.game_podium_monster.rotate(false)
        $pressed:
          image-clip: 0 20 20 20

      PodiumRotateButton
        id: rotateRight
        anchors.right: parent.right
        margin-right: 1
        image-clip: 20 0 20 20
        @onClick: modules.game_podium_monster.rotate(true)
        $pressed:
          image-clip: 20 20 20 20

    PodiumCheckPanel
      id: floorPanel
      size: 118 22
      anchors.top: previewGround.bottom
      anchors.horizontalCenter: previewGround.horizontalCenter
      margin-top: 6

      PodiumCheckBox
        id: floorShow
        !text: tr('Show Floor')
        text-offset: 18 -3
        checked: true
        @onCheckChange: modules.game_podium_monster.showFloor(self:isChecked())

  PodiumPanel
    id: filterCreatures
    size: 245 50
    !text: tr('Filter Creatures')
    margin-left: 493

    TextEdit
      id: searchText
      size: 225 20
      image-source: images/search-text-void
      anchors.centerIn: parent
      text-align: left
      !placeholder: tr('Type to search')
      placeholder-color: #707070
      focusable: true
      @onTextChange: modules.game_podium_monster.onSearchChange(self:getText())

      UIButton
        id: clearButton
        size: 18 18
        anchors.verticalCenter: parent.verticalCenter
        anchors.right: parent.right
        margin-right: 1
        image-source: images/clearButton
        image-clip: 0 0 18 18
        @onClick: self:getParent():clearText()
        $pressed:
          image-clip: 0 18 18 18

  ScrollablePanel
    id: creatureList
    size: 244 190
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 84
    margin-left: 494
    border-width: 1
    border-color-bottom: #727273
    border-color-right: #727273
    border-color-left: #181818
    border-color-top: #181818
    vertical-scrollbar: creatureListScrollBar
    padding-top: 6
    padding-left: 6
    padding-bottom: 2
    layout:
      type: grid
      cell-size: 108 100
      cell-spacing: 2
      num-columns: 2
      num-lines: 1000

  VerticalScrollBar
    id: creatureListScrollBar
    anchors.top: creatureList.top
    anchors.right: creatureList.right
    anchors.bottom: creatureList.bottom
    margin-bottom: 1
    margin-right: 1
    margin-top: 1
    step: 14
    pixels-scroll: true

  HorizontalSeparator
    id: separator
    anchors.top: preview.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    margin-left: 12
    margin-right: 12

  Button
    id: cancelButton
    !text: tr('Cancel')
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-right: 16
    margin-bottom: 16
    @onClick: modules.game_podium_monster.hide()

  Button
    id: okButton
    !text: tr('Ok')
    anchors.bottom: cancelButton.bottom
    anchors.right: cancelButton.left
    margin-right: 12
    @onClick: modules.game_podium_monster.apply()
